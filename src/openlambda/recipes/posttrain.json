{
  "stage": "posttrain",
  "world_size": 8,
  "training": {
    "batch_size": 4,
    "gradient_accumulation_steps": 1,
    "iters": 50000,
    "learning_rate": 5e-05,
    "vlm_lr_coef": 1.0,
    "conditioning_lr_coef": 1.0,
    "weight_decay": 1e-10,
    "betas": [
      0.9,
      0.95
    ],
    "max_grad_norm": 1.0,
    "freeze_steps": 0,
    "warmup_steps": 0,
    "new_module_warmup_steps": 0,
    "use_cosine_decay": true,
    "min_lr_ratio": 0.01,
    "num_actions": 50,
    "state_conditioning_mode": "discrete_vlm",
    "state_discrete_bins": 256,
    "use_proprio": true,
    "action_expert_noise_samples": 4,
    "rtc_max_delay": 8,
    "ema_decay": 0.999,
    "ema_update_interval": 1,
    "validation_interval": 1000,
    "validation_noise_samples": 4,
    "validation_action_chunk_mse": true,
    "validation_action_chunk_steps": 10,
    "validation_action_chunk_samples": 1,
    "validation_use_ema": false,
    "save_interval": 10000
  }
}

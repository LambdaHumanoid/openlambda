{
  "stage": "posttrain",
  "initialization": "midtrain",
  "midtrain_weight_source": "raw",
  "prediction_type": "velocity",
  "model": "${MIDTRAIN_MODEL_DIR}",
  "data": "${BUNDLE_DIR}",
  "data_root": "${DATA_ROOT}",
  "output": "${OUTPUT_DIR}",
  "seed": 297,
  "batch_size": 4,
  "global_batch_size": 192,
  "gradient_accumulation_steps": 1,
  "num_workers": 4,
  "rtc": true,
  "resume": "none",
  "training": {
    "iters": 100000,
    "num_domains": 30,
    "reset_action_space_ids": [3],
    "trainable_action_space_ids": [3],
    "learning_rate": 0.0001,
    "vlm_lr_coef": 0.1,
    "conditioning_lr_coef": 1.0,
    "weight_decay": 1e-10,
    "betas": [0.9, 0.95],
    "max_grad_norm": 1.0,
    "warmup_steps": 0,
    "new_module_warmup_steps": 0,
    "min_lr_ratio": 0.01,
    "state_conditioning_mode": "discrete_vlm",
    "state_discrete_bins": 256,
    "validation_interval": 1000,
    "validation_samples_per_episode": 4,
    "validation_max_batches": 0,
    "validation_action_chunk_steps": 10,
    "save_interval": 1000,
    "log_interval": 20,
    "gradient_checkpointing": false,
    "action_expert_gradient_checkpointing": true,
    "mixed_precision": "bf16",
    "dtype": "auto",
    "require_fast_linear_attention": true,
    "fused_optimizer": true,
    "ddp_find_unused_parameters": false,
    "allow_world_size_change": false,
    "deterministic": false,
    "report_to": ["tensorboard", "wandb"],
    "wandb_project": "Lambda0-Sim-Posttrain"
  }
}

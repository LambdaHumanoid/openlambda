diff --git a/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/include/lower_body_braking_priority_slew.hpp b/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/include/lower_body_braking_priority_slew.hpp

+def _read_jsonl(path: Path) -> list[dict[str, Any]]:
+    try:
+        lines = path.read_text(encoding="utf-8").splitlines()
+    except FileNotFoundError as exc:
+        raise ValueError(f"missing LeRobot episode metadata: {path}") from exc
+    records: list[dict[str, Any]] = []
+    for line_number, line in enumerate(lines, start=1):
+        if not line.strip():
+            continue
+        try:
+            value = json.loads(line)
+        except json.JSONDecodeError as exc:
+            raise ValueError(f"invalid JSON at {path}:{line_number}: {exc}") from exc
+        if not isinstance(value, dict):
+            raise ValueError(f"episode metadata must be an object at {path}:{line_number}")
+        records.append(value)
+    return records
+
+
+def detect_replay_protocol(columns: Iterable[str], requested: str = "auto") -> str:
+    available = set(columns)
+    missing_by_protocol = {
+        "pose": sorted(POSE_COLUMNS - available),
+        "joint": sorted(JOINT_COLUMNS - available),
+        "planner": sorted(PLANNER_COLUMNS - available),
+        "vr3pt": sorted(VR3PT_COLUMNS - available),
+    }
+    if requested != "auto":
+        missing = missing_by_protocol[requested]
+        if missing:
+            raise ValueError(
+                f"requested {requested} replay but parquet is missing: {', '.join(missing)}"
+            )
+        return requested
+
+    # The clean SONIC datasets retain several diagnostic representations.  POSE
+    # is the faithful live-replay path and therefore wins when it is available.
+    for protocol in ("pose", "vr3pt", "joint", "planner"):
+        if not missing_by_protocol[protocol]:
+            return protocol
+    details = "; ".join(
+        f"{name} missing {','.join(missing)}"
+        for name, missing in missing_by_protocol.items()
+    )
+    raise ValueError(f"parquet is not SONIC replay compatible ({details})")
+
+
+def discover_dataset(root: str | Path, requested_protocol: str = "auto") -> DatasetSpec:
+    dataset_root = Path(root).expanduser().resolve()
+    info = _read_json(dataset_root / "meta/info.json")
+    episode_records = _read_jsonl(dataset_root / "meta/episodes.jsonl")
+
+    try:
+        total_episodes = int(info["total_episodes"])
+        fps_float = float(info["fps"])
+        chunks_size = int(info.get("chunks_size", 1000))
+        data_template = str(
+            info.get(
+                "data_path",
+                "data/chunk-{episode_chunk:03d}/episode_{episode_index:06d}.parquet",
+            )
+        )
+    except (KeyError, TypeError, ValueError) as exc:
+        raise ValueError(f"invalid LeRobot info.json: {exc}") from exc
+    if total_episodes <= 0:
+        raise ValueError("LeRobot dataset has no episodes")
+    if chunks_size <= 0:
+        raise ValueError("LeRobot chunks_size must be positive")
+    if fps_float <= 0 or not fps_float.is_integer():
+        raise ValueError(f"SONIC replay requires an integer positive dataset fps, got {fps_float}")
+    fps = int(fps_float)
+    if len(episode_records) != total_episodes:
+        raise ValueError(
+            f"episode metadata count {len(episode_records)} != total_episodes {total_episodes}"
+        )
+
+    episodes: list[EpisodeSpec] = []
+    seen_indices: set[int] = set()
+    for record in episode_records:
+        try:
+            episode_index = int(record["episode_index"])
+            declared_length = int(record["length"])
+        except (KeyError, TypeError, ValueError) as exc:
+            raise ValueError(f"invalid episode metadata record {record!r}: {exc}") from exc
+        if episode_index in seen_indices:
+            raise ValueError(f"duplicate episode_index in metadata: {episode_index}")
+        seen_indices.add(episode_index)
+        if episode_index < 0 or declared_length <= 0:
+            raise ValueError(f"invalid episode {episode_index} length: {declared_length}")
+        episode_chunk = episode_index // chunks_size
+        relative_path = data_template.format(
+            episode_chunk=episode_chunk,
+            episode_index=episode_index,
+        )
+        parquet_path = (dataset_root / relative_path).resolve()
+        if not parquet_path.is_file():
+            raise ValueError(f"missing episode parquet: {parquet_path}")
+        parquet_file = pq.ParquetFile(parquet_path)
+        actual_length = int(parquet_file.metadata.num_rows)
+        if actual_length != declared_length:
+            raise ValueError(
+                f"episode {episode_index} length metadata={declared_length}, parquet={actual_length}"
+            )
+        protocol = detect_replay_protocol(
+            parquet_file.schema_arrow.names,
+            requested=requested_protocol,
+        )
+        raw_tasks = record.get("tasks", [])
+        tasks = tuple(str(item) for item in raw_tasks) if isinstance(raw_tasks, list) else ()
+        episodes.append(
+            EpisodeSpec(
+                episode_index=episode_index,
+                length=actual_length,
+                parquet_path=parquet_path,
+                protocol=protocol,
+                tasks=tasks,
+            )
+        )
+
+    expected_indices = set(range(total_episodes))
+    if seen_indices != expected_indices:
+        missing = sorted(expected_indices - seen_indices)
+        extra = sorted(seen_indices - expected_indices)
+        raise ValueError(f"episode indices are not contiguous; missing={missing}, extra={extra}")
+    episodes.sort(key=lambda episode: episode.episode_index)
+    return DatasetSpec(
+        root=dataset_root,
+        fps=fps,
+        total_episodes=total_episodes,
+        episodes=tuple(episodes),
+    )
+
+
+def parse_episode_selection(expression: str, total_episodes: int) -> list[int]:
+    text = expression.strip().lower()
+    if text in {"", "all", "*"}:
+        return list(range(total_episodes))
+    selected: set[int] = set()
+    for token in text.split(","):
+        token = token.strip()
+        if not token:
+            continue
+        if ":" in token:
+            fields = token.split(":")
+            if len(fields) not in {2, 3}:
+                raise ValueError(f"invalid episode range: {token}")
+            start = int(fields[0]) if fields[0] else 0
+            stop = int(fields[1]) if fields[1] else total_episodes
+            step = int(fields[2]) if len(fields) == 3 and fields[2] else 1
+            if step <= 0:
+                raise ValueError(f"episode range step must be positive: {token}")
+            selected.update(range(start, stop, step))
+        else:
+            selected.add(int(token))
+    invalid = sorted(index for index in selected if index < 0 or index >= total_episodes)
+    if invalid:
+        raise ValueError(
+            f"episode selection is outside [0, {total_episodes}): {invalid}"
+        )
+    if not selected:
+        raise ValueError("episode selection is empty")
+    return sorted(selected)
+

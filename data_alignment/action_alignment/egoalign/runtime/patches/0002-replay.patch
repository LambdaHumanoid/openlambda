+
+def _pose_row_index_for_upper_body(
+    upper_idx: int,
+    pose_rows: int,
+    upper_body_df: pd.DataFrame | None,
+) -> int:
+    """Map an upper-body overlay row to the POSE baseline row it should accompany."""
+
+    if pose_rows <= 0:
+        return 0
+    if upper_body_df is not None and "debug.raw_frame_index" in upper_body_df.columns:
+        try:
+            raw_idx = int(np.asarray(upper_body_df.iloc[int(upper_idx)]["debug.raw_frame_index"]).reshape(-1)[0])
+            return min(max(raw_idx, 0), pose_rows - 1)
+        except Exception:
+            pass
+    return min(max(int(upper_idx), 0), pose_rows - 1)
+
+
+def _pack_planner_for_row(row) -> bytes:
+    mode = int(_scalar(row.get("teleop.planner_mode"), 0))
+    movement = np.asarray(row["teleop.planner_movement"], dtype=np.float32).tolist()
+    facing = np.asarray(row["teleop.planner_facing"], dtype=np.float32).tolist()
+    speed = float(_scalar(row.get("teleop.planner_speed"), -1.0))
+    height = float(_scalar(row.get("teleop.planner_height"), -1.0))
+    left_hand = _hand_joints_for_zmq(row["teleop.left_hand_joints"]).tolist()
+    right_hand = _hand_joints_for_zmq(row["teleop.right_hand_joints"]).tolist()
+    stream_mode = _stream_mode_value(row.get("teleop.stream_mode", 0))
+    send_vr3pt = stream_mode == STREAM_MODE_PLANNER_VR_3PT
+    vr_position_array = _optional_vector(row, "teleop.vr_3pt_position", 9) if send_vr3pt else None
+    vr_position = vr_position_array.tolist() if vr_position_array is not None else None
+    vr_orientation_array = _optional_vr3pt_orientation(row) if send_vr3pt else None
+    vr_orientation = vr_orientation_array.tolist() if vr_orientation_array is not None else None
+    return build_planner_message(
+        mode, movement, facing, speed=speed, height=height,
+        left_hand_position=left_hand, right_hand_position=right_hand,
+        vr_3pt_position=vr_position,
+        vr_3pt_orientation=vr_orientation,
+    )
+
+
+def _state_vector(msg: dict, key: str) -> np.ndarray | None:
+    if msg is None or key not in msg:
+        return None
+    arr = np.asarray(msg[key], dtype=np.float32).reshape(-1)
+    if arr.size == 0:
+        return None
+    return arr
+
+
+def _state_index(msg: dict | None) -> int | None:
+    if msg is None or "index" not in msg:
+        return None
+    try:
+        value = float(np.asarray(msg["index"]).reshape(-1)[0])
+    except Exception:
+        return None
+    if not np.isfinite(value):
+        return None
+    return int(round(value))
+
+
+def _wait_for_consecutive_control_ticks(
+    *,
+    state_sub: ZMQStateSubscriber,
+    command_socket,
+    first_msg: dict,
+    required_ticks: int,
+    timeout_s: float,
+) -> tuple[int, int]:
+    """Fill policy history with fresh PLANNER ticks before changing input mode."""
+
+    required = max(0, int(required_ticks))
+    first_index = _state_index(first_msg)
+    if first_index is None:
+        raise RuntimeError("first g1_debug state has no valid C++ control index")
+    if required == 0:
+        return first_index, first_index
+
+    deadline = time.monotonic() + timeout_s
+    last_index = first_index
+    consecutive = 0
+    last_send = 0.0
+    while time.monotonic() < deadline:
+        now = time.monotonic()
+        if now - last_send >= 0.5:
+            command_socket.send(
+                build_command_message(start=True, stop=False, planner=True)
+            )
+            last_send = now
+        msg = state_sub.get_msg(clear=True)
+        index = _state_index(msg)
+        if index is None or index <= last_index:
+            time.sleep(0.002)
+            continue
+        if index == last_index + 1:
+            consecutive += 1
+        else:
+            # CONFLATE should not normally skip at a 2 ms poll cadence.  A
+            # discontinuity starts a new sequence rather than silently
+            # treating an unknown history interval as settled.
+            consecutive = 1
+        last_index = index
+        if consecutive >= required:
+            return first_index, last_index
+        time.sleep(0.002)
+
+    raise RuntimeError(
+        f"C++ planner did not publish {required} consecutive control ticks "
+        f"within {timeout_s:g}s (first={first_index}, last={last_index})"
+    )
+
+
+def _dump_ramp_state(
+    *,
+    path: str,
+    state_sub: ZMQStateSubscriber,
+    samples: int,
+    period: float,
+) -> None:
+    dump_path = Path(path).expanduser()
+    latest: dict[str, np.ndarray] = {}
+    keys = (
+        "body_q",
+        "body_q_measured",
+        "body_q_target",
+        "body_dq",
+        "last_action",
+        "base_quat",
+        "base_quat_measured",
+        "base_trans_target",
+        "base_trans_measured",
+    )
+    for _ in range(max(1, int(samples))):
+        msg = state_sub.get_msg(clear=True)
+        if msg is not None:
+            for key in keys:
+                vec = _state_vector(msg, key)
+                if vec is not None:
+                    latest[key] = vec
+        time.sleep(min(max(period, 0.001), 0.05))
+
+    if "body_q" not in latest and "body_q_measured" not in latest:
+        raise RuntimeError("no body_q/body_q_measured received from g1_debug after ramp")
+
+    dump_path.parent.mkdir(parents=True, exist_ok=True)
+    np.savez(dump_path, **latest)
+    print(_green(f"Saved ramp g1_debug state: {dump_path} ({', '.join(sorted(latest))})"))
+
+
+def _send_sim_control_command(host: str, port: int, command: str, timeout: float) -> str:
+    ctx = zmq.Context()
+    sock = ctx.socket(zmq.REQ)
+    timeout_ms = max(1, int(round(float(timeout) * 1000.0)))
+    sock.setsockopt(zmq.RCVTIMEO, timeout_ms)
+    sock.setsockopt(zmq.SNDTIMEO, timeout_ms)
+    sock.setsockopt(zmq.LINGER, 0)
+    try:
+        sock.connect(f"tcp://{host}:{int(port)}")
+        sock.send_string(command)
+        return sock.recv_string()
+    finally:
+        sock.close(0)
+        ctx.term()
+
+
+def _maybe_release_sim_elastic_band(
+    config: ReplayerConfig,
+    *,
+    send_command=_send_sim_control_command,
+    sleep_fn=time.sleep,
+) -> tuple[bool, str | None]:
+    if not config.release_elastic_band_before_replay:
+        return False, None
+    reply = send_command(
+        config.sim_control_host,
+        config.sim_control_port,
+        "elastic:disable",
+        config.sim_control_timeout,
+    )
+    if config.sim_control_settle_seconds > 0:
+        sleep_fn(float(config.sim_control_settle_seconds))
+    return True, reply
+
+
+def _maybe_reset_sim_before_replay(
+    config: ReplayerConfig,
+    *,
+    send_command=_send_sim_control_command,
+    sleep_fn=time.sleep,
+) -> tuple[bool, str | None]:
+    if not config.reset_sim_before_replay:
+        return False, None
+    reply = send_command(
+        config.sim_control_host,
+        config.sim_control_port,
+        "sim:reset",
+        config.sim_control_timeout,
+    )
+    if config.sim_control_settle_seconds > 0:

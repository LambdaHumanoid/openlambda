+def main(config: ReplayerConfig):
+    if config.sim_video_name and config.loop:
+        print("ERROR: --sim-video-name cannot be combined with --loop", file=sys.stderr)
+        sys.exit(1)
+    if config.max_frames < 0:
+        print("ERROR: --max-frames must be non-negative", file=sys.stderr)
+        sys.exit(1)
+    if (
+        config.initial_body_q_reference_path
+        and not config.release_elastic_band_before_replay
+    ):
+        print(
+            "ERROR: strict initial body-q gate requires "
+            "--release-elastic-band-before-replay",
+            file=sys.stderr,
+        )
+        sys.exit(1)
+    if (
+        config.sim_stability_timeout <= 0
+        or config.sim_stability_poll_hz <= 0
+        or config.sim_stability_hold_seconds < 0
+        or config.sim_max_root_linear_speed < 0
+        or config.sim_max_root_angular_speed < 0
+        or config.sim_max_body_joint_speed < 0
+        or config.initial_body_q_max_error_rad <= 0
+        or config.initial_body_q_rms_error_rad <= 0
+    ):
+        print(
+            "ERROR: MuJoCo stability timeout/poll rate must be positive and "
+            "hold/motion thresholds must be non-negative and initial-pose "
+            "thresholds must be positive",
+            file=sys.stderr,
+        )
+        sys.exit(1)
+    if not os.path.isfile(config.parquet_path):
+        print(f"ERROR: parquet not found: {config.parquet_path}", file=sys.stderr)
+        sys.exit(1)
+
+    print(f"Loading {config.parquet_path}")
+    df = pd.read_parquet(config.parquet_path)
+    if len(df) == 0:
+        print("ERROR: parquet is empty", file=sys.stderr)
+        sys.exit(1)
+    try:
+        df = _prepare_replay_dataframe(df, config.replay_protocol)
+    except ValueError as exc:
+        print(f"ERROR: {exc}", file=sys.stderr)
+        sys.exit(1)
+    if config.max_frames > 0 and len(df) > config.max_frames:
+        replay_attrs = dict(df.attrs)
+        df = df.iloc[: config.max_frames].reset_index(drop=True)
+        df.attrs.update(replay_attrs)
+        print(_yellow(f"Replay limited to first {len(df)} rows by --max-frames."))
+    baseline_ramp_df: pd.DataFrame | None = None
+    if config.baseline_ramp_parquet:
+        if not os.path.isfile(config.baseline_ramp_parquet):
+            print(f"ERROR: baseline_ramp_parquet not found: {config.baseline_ramp_parquet}", file=sys.stderr)
+            sys.exit(1)
+        try:
+            baseline_ramp_df = _prepare_replay_dataframe(
+                pd.read_parquet(config.baseline_ramp_parquet),
+                replay_protocol="pose",
+            )
+        except ValueError as exc:
+            print(f"ERROR: unusable baseline_ramp_parquet: {exc}", file=sys.stderr)
+            sys.exit(1)
+    initial_body_q_reference: np.ndarray | None = None
+    if config.initial_body_q_reference_path:
+        try:
+            initial_body_q_reference = _load_initial_body_q_reference(
+                config.initial_body_q_reference_path
+            )
+        except (OSError, KeyError, TypeError, ValueError) as exc:
+            print(f"ERROR: unusable initial body-q reference: {exc}", file=sys.stderr)
+            sys.exit(1)
+
+    neutral_pose_df: pd.DataFrame | None = None
+    if config.neutral_pose_parquet:
+        if not os.path.isfile(config.neutral_pose_parquet):
+            print(f"ERROR: neutral_pose_parquet not found: {config.neutral_pose_parquet}", file=sys.stderr)
+            sys.exit(1)
+        try:
+            neutral_pose_df = _prepare_replay_dataframe(
+                pd.read_parquet(config.neutral_pose_parquet),
+                replay_protocol="pose",
+            )
+        except ValueError as exc:
+            print(f"ERROR: unusable neutral_pose_parquet: {exc}", file=sys.stderr)
+            sys.exit(1)
+        if len(neutral_pose_df) == 0:
+            print("ERROR: neutral_pose_parquet is empty", file=sys.stderr)
+            sys.exit(1)
+
+    upper_body_df: pd.DataFrame | None = None
+    if config.upper_body_joint_parquet:
+        if not os.path.isfile(config.upper_body_joint_parquet):
+            print(f"ERROR: upper_body_joint_parquet not found: {config.upper_body_joint_parquet}", file=sys.stderr)
+            sys.exit(1)
+        try:
+            upper_body_df = _prepare_replay_dataframe(
+                pd.read_parquet(config.upper_body_joint_parquet),
+                replay_protocol="joint",
+            )
+        except ValueError as exc:
+            print(f"ERROR: unusable upper_body_joint_parquet: {exc}", file=sys.stderr)
+            sys.exit(1)
+        if len(upper_body_df) == 0:
+            print("ERROR: upper_body_joint_parquet is empty", file=sys.stderr)
+            sys.exit(1)
+
+    if df.attrs.get("replay_source") == "raw_pico":
+        print(_yellow(
+            "Input is raw PICO parquet; converted observation.pico.body_pose to SONIC POSE replay fields."
+        ))
+    elif df.attrs.get("replay_source") == "raw_pico_vr3pt":
+        print(_yellow(
+            "Input is raw PICO parquet; converted observation.pico.body_pose to SONIC VR3pt planner fields "
+            f"(calibration={df.attrs.get('vr3pt_calibration', 'first-frame')})."
+        ))
+    elif df.attrs.get("replay_source") == "vr3pt":
+        print(_yellow("Input is SONIC VR3pt planner parquet; using planner vr_position/vr_orientation replay."))
+    elif df.attrs.get("replay_source") == "g1_joint":
+        print(_yellow("Input is G1 joint parquet; using SONIC protocol v1 joint replay."))
+        if config.joint_pos_is_offset:
+            print(_yellow(
+                "teleop.g1_joint_pos is treated as default-relative offset; "
+                "sending default+offset absolute joint_pos to protocol v1."
+            ))
+    elif df.attrs.get("stream_mode_defaulted"):

diff --git a/gear_sonic/utils/mujoco_sim/zmq_mock_channel.py b/gear_sonic/utils/mujoco_sim/zmq_mock_channel.py
new file mode 100644
--- /dev/null
+++ b/gear_sonic/utils/mujoco_sim/zmq_mock_channel.py
@@ -0,0 +1,204 @@
+"""ZMQ Mock channel for in-process MuJoCo simulation.
+
+Drop-in replacement for `unitree_sdk2py.core.channel.ChannelPublisher /
+ChannelSubscriber` when used by the MuJoCo bridge (a.k.a. the sim "robot
+side"). Instead of going over loopback DDS, the sim binds a local ZMQ PUB
+(state) + SUB (cmd) pair so that the host's `ZmqChannelSubscriber /
+ZmqChannelPublisher` can connect to `tcp://localhost:5560/5561` exactly as
+they would to the real robot's bridge.
+
+This keeps `homie/control/envs/g1/sim/unitree_sdk2py_bridge.py`
+untouched in shape: it constructs `unitree_hg_msg_dds__LowState_()` etc.,
+stuffs joint values into them, then calls `.Write(msg)` / `.Read()` —
+serialization to msgpack happens here via the duck-typed `zmq_serializer`.
+
+Singleton sockets per (kind, port): all publishers in this process share
+one PUB socket, all subscribers share one SUB socket. Topic filtering on
+the SUB side is done in Python (per-topic deque cache) since we PUB
+multiple topics (lowstate, lowcmd, etc) over the same socket pair.
+"""
+
+import threading
+import time
+from typing import Any, Callable, Dict, Optional
+
+import zmq
+
+# Reuse the canonical msgpack wire format from homie so HOMIE and SONIC
+# stay byte-compatible.
+from homie.control.envs.g1.utils.zmq_serializer import (
+    deserialize_message,
+    serialize_message,
+)
+
+
+class _MockServer:
+    """Singleton server-side socket pair for the sim. Binds PUB+SUB."""
+
+    _instance: Optional["_MockServer"] = None
+    _lock = threading.Lock()
+
+    def __new__(cls):
+        if cls._instance is None:
+            with cls._lock:
+                if cls._instance is None:
+                    cls._instance = super().__new__(cls)
+                    cls._instance._initialized = False
+        return cls._instance
+
+    def __init__(self):
+        if self._initialized:
+            return
+        self._initialized = True
+        self.ctx: Optional[zmq.Context] = None
+        self.pub: Optional[zmq.Socket] = None
+        self.sub: Optional[zmq.Socket] = None
+        self._sub_lock = threading.Lock()
+        self._topic_msgs: Dict[str, Any] = {}
+        self._sub_thread: Optional[threading.Thread] = None
+        self._running = False
+        self._sub_topics: Dict[str, bool] = {}
+        self._topic_handlers: Dict[str, Any] = {}
+
+    def init(
+        self,
+        bind_host: str = "*",
+        state_port: int = 5560,
+        cmd_port: int = 5561,
+    ):
+        if self.ctx is not None:
+            return
+        self.ctx = zmq.Context()
+
+        self.pub = self.ctx.socket(zmq.PUB)
+        self.pub.bind(f"tcp://{bind_host}:{state_port}")
+        self.pub.setsockopt(zmq.SNDHWM, 1000)
+        print(f"[MockServer] state PUB bound to tcp://{bind_host}:{state_port}")
+
+        self.sub = self.ctx.socket(zmq.SUB)
+        self.sub.bind(f"tcp://{bind_host}:{cmd_port}")
+        self.sub.setsockopt(zmq.RCVHWM, 10)
+        self.sub.setsockopt(zmq.RCVTIMEO, 100)
+        print(f"[MockServer] cmd SUB bound to tcp://{bind_host}:{cmd_port}")
+
+        self._running = True
+        self._sub_thread = threading.Thread(target=self._sub_loop, daemon=True)
+        self._sub_thread.start()
+
+    def _sub_loop(self):
+        while self._running:
+            try:
+                parts = self.sub.recv_multipart()
+            except zmq.Again:
+                continue
+            except zmq.ZMQError:
+                if not self._running:
+                    return
+                continue
+            # Tolerate any frame count >= 2 (SONIC C++ ZmqRobotChannel may send 3 frames).
+            if len(parts) < 2:
+                continue
+            topic_b, data = parts[0], parts[1]
+            topic = topic_b.decode("utf-8")
+            try:
+                msg = deserialize_message(topic, data)
+            except Exception:
+                continue
+            with self._sub_lock:
+                self._topic_msgs[topic] = msg
+                handler = self._topic_handlers.get(topic)
+            if handler is not None:
+                try:
+                    handler(msg)
+                except Exception as e:
+                    print(f"[MockServer] handler error ({topic}): {e}")
+
+    def subscribe(self, topic: str, handler=None):
+        if handler is not None:
+            self._topic_handlers[topic] = handler
+        if topic in self._sub_topics:
+            return
+        self._sub_topics[topic] = True
+        if self.sub is not None:
+            self.sub.setsockopt_string(zmq.SUBSCRIBE, topic)
+
+    def get_latest(self, topic: str):
+        with self._sub_lock:
+            return self._topic_msgs.get(topic)
+
+    def publish(self, topic: str, msg):
+        if self.pub is None:
+            return
+        try:
+            data = serialize_message(topic, msg)
+            self.pub.send_multipart([topic.encode("utf-8"), data], zmq.NOBLOCK)
+        except zmq.Again:
+            pass
+        except Exception as e:
+            print(f"[MockServer] publish error ({topic}): {e}")
+
+    def shutdown(self):
+        self._running = False
+        if self._sub_thread is not None:
+            self._sub_thread.join(timeout=1.0)
+        if self.pub is not None:
+            self.pub.close()
+            self.pub = None
+        if self.sub is not None:
+            self.sub.close()
+            self.sub = None
+        if self.ctx is not None:
+            self.ctx.term()
+            self.ctx = None
+
+
+def MockServerInitialize(bind_host: str = "*", state_port: int = 5560, cmd_port: int = 5561):
+    """Idempotent server init. Call once before constructing any pub/sub."""
+    _MockServer().init(bind_host=bind_host, state_port=state_port, cmd_port=cmd_port)
+
+
+class ChannelPublisher:
+    """Sim-side mock that mimics `unitree_sdk2py.core.channel.ChannelPublisher`.
+
+    Args mirror the DDS class so existing call sites compile unchanged.
+    """
+
+    def __init__(self, topic: str, msg_type: Any = None):
+        self._topic = topic
+        self._msg_type = msg_type  # ignored
+
+    def Init(self):
+        # Ensure server is up; users may forget to call MockServerInitialize.
+        _MockServer().init()
+
+    def Write(self, msg):
+        _MockServer().publish(self._topic, msg)
+
+
+class ChannelSubscriber:
+    """Sim-side mock that mimics `unitree_sdk2py.core.channel.ChannelSubscriber`."""
+
+    def __init__(self, topic: str, msg_type: Any = None):
+        self._topic = topic
+        self._msg_type = msg_type  # ignored
+
+    def Init(self, handler: Callable = None, queueLen: int = 0):
+        srv = _MockServer()
+        srv.init()
+        srv.subscribe(self._topic, handler=handler)
+
+    def Read(self, timeout: float = None) -> Optional[Any]:
+        srv = _MockServer()
+        if timeout is None:
+            while True:
+                msg = srv.get_latest(self._topic)
+                if msg is not None:
+                    return msg
+                time.sleep(0.001)
+        deadline = time.time() + timeout
+        while time.time() < deadline:
+            msg = srv.get_latest(self._topic)
+            if msg is not None:
+                return msg
+            time.sleep(0.001)
+        return None

+    parser.add_argument("--output-dir", required=True, type=Path)
+    parser.add_argument("--episodes", default="all", help="all, comma-list, or slices such as 0:10,20")
+    parser.add_argument("--limit", type=int, default=0)
+    parser.add_argument("--replay-protocol", choices=["auto", "pose", "joint", "planner", "vr3pt"], default="auto")
+    parser.add_argument("--rate", type=int, default=0, help="Zero uses dataset fps.")
+    parser.add_argument("--max-frames", type=int, default=0)
+    parser.add_argument("--ramp-seconds", type=float, default=5.0)
+    parser.add_argument("--startup-timeout", type=float, default=180.0)
+    parser.add_argument(
+        "--planner-settle-ticks",
+        type=int,
+        default=10,
+        help="Fresh consecutive C++ PLANNER ticks required before POSE mode.",
+    )
+    parser.add_argument("--episode-timeout", type=float, default=0.0, help="Zero derives a timeout from episode length.")
+    parser.add_argument("--sim-ready-timeout", type=float, default=60.0)
+    parser.add_argument("--sim-control-host", default="localhost")
+    parser.add_argument("--sim-control-port", type=int, default=5562)
+    parser.add_argument("--sim-control-timeout", type=float, default=30.0)
+    parser.add_argument("--sim-control-settle-seconds", type=float, default=1.0)
+    parser.add_argument("--sim-stability-timeout", type=float, default=15.0)
+    parser.add_argument("--sim-stability-poll-hz", type=float, default=10.0)
+    parser.add_argument("--sim-stability-hold-seconds", type=float, default=0.5)
+    parser.add_argument("--sim-max-root-linear-speed", type=float, default=0.10)
+    parser.add_argument("--sim-max-root-angular-speed", type=float, default=0.35)
+    parser.add_argument("--sim-max-body-joint-speed", type=float, default=1.0)
+    parser.add_argument("--zmq-host", default="localhost")
+    parser.add_argument("--zmq-port", type=int, default=5556)
+    parser.add_argument("--state-zmq-host", default="localhost")
+    parser.add_argument("--state-zmq-port", type=int, default=5557)
+    parser.add_argument("--respect-timestamps", action=argparse.BooleanOptionalAction, default=False)
+    parser.add_argument("--timestamp-column", default="timestamp")
+    parser.add_argument("--reset-sim", action=argparse.BooleanOptionalAction, default=True)
+    parser.add_argument(
+        "--sim-prepared-before-deploy",
+        action=argparse.BooleanOptionalAction,
+        default=False,
+        help=(
+            "The external deploy supervisor resets MuJoCo before every fresh "
+            "C++ deploy; requires --no-reset-sim."

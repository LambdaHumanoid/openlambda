+def _sim_lifecycle_counters(payload: dict[str, object]) -> tuple[int, int]:
+    try:
+        reset_generation = int(payload["reset_generation"])
+        fall_event_count = int(payload["fall_event_count"])
+    except (KeyError, TypeError, ValueError) as exc:
+        raise RuntimeError(
+            f"sim-state payload is missing lifecycle counters: {payload!r}"
+        ) from exc
+    if reset_generation < 0 or fall_event_count < 0:
+        raise RuntimeError(f"invalid sim lifecycle counters: {payload!r}")
+    return reset_generation, fall_event_count
+
+
+def _validate_released_sim_state(
+    payload: dict[str, object],
+    *,
+    stage: str,
+    expected_reset_generation: int,
+    expected_fall_event_count: int,
+    minimum_root_height_m: float = 0.5,
+) -> None:
+    reset_generation, fall_event_count = _sim_lifecycle_counters(payload)
+    if reset_generation != expected_reset_generation:
+        raise RuntimeError(
+            f"{stage}: MuJoCo reset after elastic release "
+            f"(generation {expected_reset_generation} -> {reset_generation})"
+        )
+    if fall_event_count != expected_fall_event_count:
+        raise RuntimeError(
+            f"{stage}: MuJoCo fall after elastic release "
+            f"(events {expected_fall_event_count} -> {fall_event_count})"
+        )
+    if payload.get("elastic_band_available") is not True:
+        raise RuntimeError(f"{stage}: MuJoCo elastic band is unavailable")
+    if payload.get("elastic_band_enabled") is not False:
+        raise RuntimeError(
+            f"{stage}: MuJoCo elastic band was re-enabled after release"
+        )
+    if payload.get("fallen") is True:
+        raise RuntimeError(f"{stage}: MuJoCo reports a fallen robot")
+    try:
+        root_position = np.asarray(payload["root_position"], dtype=np.float64).reshape(
+            -1
+        )
+    except (KeyError, TypeError, ValueError) as exc:
+        raise RuntimeError(f"{stage}: invalid MuJoCo root position") from exc
+    if root_position.shape != (3,) or not np.isfinite(root_position).all():
+        raise RuntimeError(
+            f"{stage}: invalid MuJoCo root position {root_position!r}"
+        )
+    if float(root_position[2]) < float(minimum_root_height_m):
+        raise RuntimeError(
+            f"{stage}: MuJoCo root height {root_position[2]:.3f} m is below "
+            f"{minimum_root_height_m:.3f} m"
+        )
+
+
+def _sim_motion_metrics(payload: dict[str, object]) -> dict[str, float]:
+    vectors = {}
+    for key, size in (
+        ("root_linear_velocity", 3),
+        ("root_angular_velocity", 3),
+        ("body_joint_velocity", 29),
+    ):
+        try:
+            value = np.asarray(payload[key], dtype=np.float64).reshape(-1)
+        except (KeyError, TypeError, ValueError) as exc:
+            raise RuntimeError(f"invalid MuJoCo {key}") from exc
+        if value.shape != (size,) or not np.isfinite(value).all():
+            raise RuntimeError(f"invalid MuJoCo {key}: {value!r}")
+        vectors[key] = value
+    return {
+        "root_linear_speed": float(
+            np.linalg.norm(vectors["root_linear_velocity"])
+        ),
+        "root_angular_speed": float(
+            np.linalg.norm(vectors["root_angular_velocity"])
+        ),
+        "max_body_joint_speed": float(
+            np.max(np.abs(vectors["body_joint_velocity"]))
+        ),
+    }
+
+
+def _load_initial_body_q_reference(path: str | Path) -> np.ndarray:
+    """Load one hash-provenanced baseline 29D MuJoCo-order pose."""
+
+    reference_path = Path(path).expanduser()
+    with np.load(reference_path, allow_pickle=False) as payload:
+        required = {
+            "contract",
+            "joint_names",
+            "body_q_reference",
+            "baseline_control_sha256",
+        }
+        missing = sorted(required - set(payload.files))
+        if missing:
+            raise ValueError(
+                f"initial body-q reference is missing fields: {', '.join(missing)}"
+            )
+        contract = str(np.asarray(payload["contract"]).item())
+        if contract != INITIAL_BODY_Q_REFERENCE_CONTRACT:
+            raise ValueError(
+                f"initial body-q contract {contract!r} != "
+                f"{INITIAL_BODY_Q_REFERENCE_CONTRACT!r}"
+            )
+        names = tuple(str(value) for value in payload["joint_names"])
+        if names != tuple(MUJOCO_BODY_JOINT_NAMES):
+            raise ValueError("initial body-q reference joint order is not MuJoCo order")
+        source_sha = str(np.asarray(payload["baseline_control_sha256"]).item())
+        if len(source_sha) != 64 or any(
+            character not in "0123456789abcdef" for character in source_sha
+        ):
+            raise ValueError("initial body-q reference has invalid provenance hash")
+        body_q = np.asarray(payload["body_q_reference"], dtype=np.float64).reshape(-1)
+    if body_q.shape != (len(MUJOCO_BODY_JOINT_NAMES),) or not np.isfinite(body_q).all():
+        raise ValueError(
+            "initial body-q reference must be one finite 29D MuJoCo-order vector"
+        )
+    return body_q
+
+
+def _initial_body_q_error_metrics(
+    payload: dict[str, object],
+    reference: np.ndarray,
+) -> dict[str, float]:
+    """Compare measured MuJoCo q using wrapped angular differences."""
+
+    try:
+        actual = np.asarray(
+            payload["body_joint_position"], dtype=np.float64
+        ).reshape(-1)
+    except (KeyError, TypeError, ValueError) as exc:
+        raise RuntimeError("invalid MuJoCo body_joint_position") from exc
+    expected = np.asarray(reference, dtype=np.float64).reshape(-1)
+    if (
+        actual.shape != (len(MUJOCO_BODY_JOINT_NAMES),)
+        or expected.shape != actual.shape
+        or not np.isfinite(actual).all()
+        or not np.isfinite(expected).all()
+    ):
+        raise RuntimeError("invalid 29D initial-body pose comparison")
+    error = (actual - expected + np.pi) % (2.0 * np.pi) - np.pi
+    absolute = np.abs(error)
+    return {
+        "initial_body_q_max_error_rad": float(np.max(absolute)),
+        "initial_body_q_rms_error_rad": float(np.sqrt(np.mean(error**2))),
+    }
+
+
+def _validate_sim_lifecycle_state(
+    payload: dict[str, object],
+    *,
+    stage: str,
+    expected_reset_generation: int,
+    expected_fall_event_count: int,
+    expected_elastic_enabled: bool,
+    minimum_root_height_m: float = 0.5,
+) -> None:
+    reset_generation, fall_event_count = _sim_lifecycle_counters(payload)
+    if reset_generation != expected_reset_generation:
+        raise RuntimeError(
+            f"{stage}: MuJoCo reset during replay initialization "
+            f"(generation {expected_reset_generation} -> {reset_generation})"
+        )
+    if fall_event_count != expected_fall_event_count:
+        raise RuntimeError(
+            f"{stage}: MuJoCo fall during replay initialization "
+            f"(events {expected_fall_event_count} -> {fall_event_count})"
+        )
+    if payload.get("elastic_band_available") is not True:
+        raise RuntimeError(f"{stage}: MuJoCo elastic band is unavailable")
+    if payload.get("elastic_band_enabled") is not expected_elastic_enabled:
+        expected_label = "enabled" if expected_elastic_enabled else "released"
+        raise RuntimeError(
+            f"{stage}: MuJoCo elastic band is not {expected_label}"
+        )
+    if payload.get("fallen") is True:
+        raise RuntimeError(f"{stage}: MuJoCo reports a fallen robot")
+    try:
+        root_position = np.asarray(payload["root_position"], dtype=np.float64).reshape(
+            -1
+        )
+    except (KeyError, TypeError, ValueError) as exc:
+        raise RuntimeError(f"{stage}: invalid MuJoCo root position") from exc
+    if root_position.shape != (3,) or not np.isfinite(root_position).all():
+        raise RuntimeError(
+            f"{stage}: invalid MuJoCo root position {root_position!r}"
+        )
+    if float(root_position[2]) < float(minimum_root_height_m):
+        raise RuntimeError(
+            f"{stage}: MuJoCo root height {root_position[2]:.3f} m is below "
+            f"{minimum_root_height_m:.3f} m"
+        )
+
+
+def _wait_for_sim_physical_stability(
+    config: ReplayerConfig,
+    *,
+    stage: str,
+    expected_reset_generation: int,
+    expected_fall_event_count: int,
+    expected_elastic_enabled: bool,
+    command_tick,
+    minimum_stable_seconds: float | None = None,
+    initial_body_q_reference: np.ndarray | None = None,
+    state_fn=_sim_state_control,
+) -> dict[str, object]:
+    """Hold the current control input until actual MuJoCo motion is stationary."""
+
+    timeout_s = float(config.sim_stability_timeout)
+    poll_hz = float(config.sim_stability_poll_hz)
+    hold_s = (
+        float(config.sim_stability_hold_seconds)
+        if minimum_stable_seconds is None
+        else float(minimum_stable_seconds)
+    )
+    if timeout_s <= 0 or poll_hz <= 0 or hold_s < 0:
+        raise ValueError("MuJoCo stability timeout/poll rate must be positive and hold non-negative")
+
+    command_period = 1.0 / max(1, int(config.rate))
+    probe_period = 1.0 / poll_hz
+    deadline = time.monotonic() + timeout_s
+    next_command = time.monotonic()
+    next_probe = next_command
+    stable_since_sim_time: float | None = None
+    last_sim_time: float | None = None
+    last_metrics: dict[str, float] | None = None
+    last_payload: dict[str, object] | None = None
+    last_progress = 0.0
+
+    while time.monotonic() < deadline:
+        if time.monotonic() >= next_command:
+            command_tick()
+            next_command += command_period
+            if next_command < time.monotonic() - command_period:
+                next_command = time.monotonic() + command_period
+
+        now = time.monotonic()
+        if now >= next_probe:
+            payload = state_fn(config)
+            _validate_sim_lifecycle_state(
+                payload,
+                stage=stage,
+                expected_reset_generation=expected_reset_generation,
+                expected_fall_event_count=expected_fall_event_count,
+                expected_elastic_enabled=expected_elastic_enabled,
+            )
+            try:
+                sim_time = float(payload["sim_time_s"])
+            except (KeyError, TypeError, ValueError) as exc:
+                raise RuntimeError(f"{stage}: invalid MuJoCo simulation time") from exc
+            if not np.isfinite(sim_time):
+                raise RuntimeError(f"{stage}: non-finite MuJoCo simulation time")
+
+            metrics = _sim_motion_metrics(payload)
+            if initial_body_q_reference is not None:
+                metrics.update(
+                    _initial_body_q_error_metrics(
+                        payload, initial_body_q_reference
+                    )
+                )
+            pose_matches = (
+                initial_body_q_reference is None
+                or (
+                    metrics["initial_body_q_max_error_rad"]
+                    <= float(config.initial_body_q_max_error_rad)
+                    and metrics["initial_body_q_rms_error_rad"]
+                    <= float(config.initial_body_q_rms_error_rad)
+                )
+            )
+            is_moving_slowly = (
+                metrics["root_linear_speed"]
+                <= float(config.sim_max_root_linear_speed)
+                and metrics["root_angular_speed"]
+                <= float(config.sim_max_root_angular_speed)
+                and metrics["max_body_joint_speed"]
+                <= float(config.sim_max_body_joint_speed)
+                and pose_matches
+            )
+            sim_advanced = last_sim_time is None or sim_time > last_sim_time
+            if is_moving_slowly and sim_advanced:
+                if stable_since_sim_time is None:
+                    stable_since_sim_time = sim_time
+                if sim_time - stable_since_sim_time >= hold_s:
+                    pose_suffix = (
+                        ""
+                        if initial_body_q_reference is None
+                        else (
+                            f", q_max={math.degrees(metrics['initial_body_q_max_error_rad']):.2f}deg, "
+                            f"q_rms={math.degrees(metrics['initial_body_q_rms_error_rad']):.2f}deg"
+                        )
+                    )
+                    print(
+                        _green(
+                            f"  ✓ {stage} physically stable for "
+                            f"{sim_time - stable_since_sim_time:.2f}s: "
+                            f"|v|={metrics['root_linear_speed']:.3f}m/s, "
+                            f"|ω|={metrics['root_angular_speed']:.3f}rad/s, "
+                            f"max|dq|={metrics['max_body_joint_speed']:.3f}rad/s"
+                            f"{pose_suffix}"
+                        )
+                    )
+                    return payload
+            else:
+                stable_since_sim_time = None
+
+            last_sim_time = sim_time
+            last_metrics = metrics
+            last_payload = payload
+            elapsed = timeout_s - max(0.0, deadline - time.monotonic())
+            if elapsed - last_progress >= 1.0:
+                pose_suffix = (
+                    ""
+                    if initial_body_q_reference is None
+                    else (
+                        f", q_max={math.degrees(metrics['initial_body_q_max_error_rad']):.1f}deg, "
+                        f"q_rms={math.degrees(metrics['initial_body_q_rms_error_rad']):.1f}deg"
+                    )
+                )
+                print(
+                    f"\r  {stage}: waiting for physical stability "
+                    f"{elapsed:4.1f}/{timeout_s:.1f}s "
+                    f"(|v|={metrics['root_linear_speed']:.3f}, "
+                    f"|ω|={metrics['root_angular_speed']:.3f}, "
+                    f"max|dq|={metrics['max_body_joint_speed']:.3f}{pose_suffix})    ",
+                    end="",
+                    flush=True,
+                )
+                last_progress = elapsed
+            next_probe = now + probe_period
+
+        wake_at = min(next_command, next_probe, deadline)
+        sleep_for = wake_at - time.monotonic()
+        if sleep_for > 0:
+            time.sleep(min(sleep_for, command_period))
+
+    details = "no valid MuJoCo state"
+    if last_metrics is not None and last_payload is not None:
+        pose_details = (
+            ""
+            if initial_body_q_reference is None
+            else (
+                f", q_max={math.degrees(last_metrics['initial_body_q_max_error_rad']):.2f}deg, "
+                f"q_rms={math.degrees(last_metrics['initial_body_q_rms_error_rad']):.2f}deg"
+            )
+        )
+        details = (
+            f"|v|={last_metrics['root_linear_speed']:.3f}m/s, "
+            f"|ω|={last_metrics['root_angular_speed']:.3f}rad/s, "
+            f"max|dq|={last_metrics['max_body_joint_speed']:.3f}rad/s, "
+            f"root={last_payload.get('root_position')}{pose_details}"
+        )
+    raise RuntimeError(
+        f"{stage}: MuJoCo did not remain physically stable for {hold_s:.2f}s "
+        f"within {timeout_s:.1f}s ({details})"
+    )
+
+
+def _start_sim_video(
+    config: ReplayerConfig,
+    *,
+    video_name: str | None = None,
+    send_command=_send_sim_control_command,
+) -> dict[str, object] | None:
+    selected_name = config.sim_video_name if video_name is None else video_name
+    if not selected_name:
+        return None
+    payload = _sim_video_control(
+        config,
+        f"replay_video:start:{selected_name}",
+        send_command=send_command,
+    )
+    if payload.get("status") != "started":
+        raise RuntimeError(f"MuJoCo did not start replay video: {payload}")
+    return payload
+
+
+def _stop_sim_video(
+    config: ReplayerConfig,
+    *,
+    send_command=_send_sim_control_command,
+) -> dict[str, object] | None:
+    payload = _sim_video_control(
+        config,
+        "replay_video:stop",
+        send_command=send_command,
+    )
+    if payload.get("status") not in {"stopped", "idle"}:
+        raise RuntimeError(f"MuJoCo did not stop replay video cleanly: {payload}")
+    return payload

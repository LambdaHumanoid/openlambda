+class _ReplayStateCapture:
+    def __init__(self, path: str, every: int, rate: float = 50.0):
+        self.path = Path(path).expanduser() if path else None
+        self.every = max(1, int(every))
+        self.rate = float(rate)
+        self.replay_frame_index: list[int] = []
+        self.local_frame_index: list[int] = []
+        self.monotonic_ns: list[int] = []
+        self.values: dict[str, list[np.ndarray]] = {key: [] for key in STATE_CAPTURE_FIELDS}
+        self.scalars: dict[str, list[float]] = {key: [] for key in STATE_CAPTURE_SCALARS}
+        self._saved = False
+        self._strict_stream = False
+        self._last_control_index: int | None = None
+
+    @property
+    def enabled(self) -> bool:
+        return self.path is not None
+
+    def _vector(self, msg: dict, key: str, size: int) -> np.ndarray:
+        vec = _state_vector(msg, key)
+        if vec is None or vec.size != size:
+            return np.full(size, np.nan, dtype=np.float32)
+        return vec.astype(np.float32, copy=False)
+
+    @staticmethod
+    def _scalar(msg: dict, key: str) -> float:
+        value = msg.get(key, np.nan)
+        try:
+            return float(np.asarray(value).reshape(-1)[0])
+        except Exception:
+            return float("nan")
+
+    def begin(self, state_sub: ZMQStateSubscriber) -> None:
+        """Arm a lossless capture boundary immediately before formal replay."""
+
+        if not self.enabled:
+            return
+        drain = getattr(state_sub, "drain", None)
+        next_msg = getattr(state_sub, "get_next_msg", None)
+        if not callable(drain) or not callable(next_msg):
+            raise RuntimeError(
+                "lossless replay capture requires a streaming state subscriber"
+            )
+        latest = drain()
+        if latest is None:
+            latest = next_msg(timeout_sec=max(1.0, 10.0 / self.rate))
+        last_index = _state_index(latest)
+        if last_index is None:
+            raise RuntimeError(
+                "cannot arm replay capture without a valid C++ control index"
+            )
+        self._last_control_index = last_index
+        self._strict_stream = True
+        print(_green(
+            "Armed lossless g1_debug capture after control index "
+            f"{last_index}; queued formal ticks will not be conflated."
+        ))
+
+    def record(
+        self,
+        *,
+        state_sub: ZMQStateSubscriber,
+        replay_frame_index: int,
+        local_frame_index: int,
+    ) -> None:
+        if not self.enabled:
+            return
+        store_sample = replay_frame_index % self.every == 0
+        if self._strict_stream:
+            deadline = time.monotonic() + max(1.0, 10.0 / self.rate)
+            msg = None
+            while time.monotonic() < deadline:
+                remaining = max(0.0, deadline - time.monotonic())
+                candidate = state_sub.get_next_msg(timeout_sec=remaining)
+                index = _state_index(candidate)
+                if index is None:
+                    continue
+                if (
+                    self._last_control_index is not None
+                    and index <= self._last_control_index
+                ):
+                    continue
+                if (
+                    self._last_control_index is not None
+                    and index != self._last_control_index + 1
+                ):
+                    raise RuntimeError(
+                        "lossless g1_debug capture skipped a C++ control tick: "
+                        f"{self._last_control_index} -> {index}"
+                    )
+                self._last_control_index = index
+                msg = candidate
+                break
+            if msg is None:
+                raise RuntimeError(
+                    "timed out waiting for the next C++ control tick during replay"
+                )
+        else:
+            if not store_sample:
+                return
+            msg = state_sub.get_msg(clear=False)
+        if msg is None:
+            return
+        if not store_sample:
+            return
+
+        self.replay_frame_index.append(int(replay_frame_index))
+        self.local_frame_index.append(int(local_frame_index))
+        self.monotonic_ns.append(time.monotonic_ns())
+        for key, size in STATE_CAPTURE_FIELDS.items():
+            self.values[key].append(self._vector(msg, key, size))
+        for key in STATE_CAPTURE_SCALARS:
+            self.scalars[key].append(self._scalar(msg, key))
+
+    def save(self) -> None:
+        if not self.enabled or self._saved:
+            return
+        self._saved = True
+        assert self.path is not None
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        payload: dict[str, np.ndarray] = {
+            "format_version": np.asarray(
+                CONTROL_CAPTURE_FORMAT_VERSION, dtype=np.int32
+            ),
+            "replay_rate": np.asarray(self.rate, dtype=np.float64),
+            # g1_debug serializes body_q/body_q_measured/body_q_target,
+            # body_dq, last_action and policy_action in physical MuJoCo order.
+            # Older captures mislabeled this vector as REFERENCE/IsaacLab
+            # order, which silently attached angles to the wrong FK joints.
+            "joint_names": np.asarray(MUJOCO_BODY_JOINT_NAMES, dtype=np.str_),
+            "measured_joint_names": np.asarray(
+                MUJOCO_BODY_JOINT_NAMES, dtype=np.str_
+            ),
+            "replay_frame_index": np.asarray(self.replay_frame_index, dtype=np.int32),
+            "local_frame_index": np.asarray(self.local_frame_index, dtype=np.int32),
+            "capture_monotonic_ns": np.asarray(self.monotonic_ns, dtype=np.int64),
+        }
+        for key, samples in self.values.items():
+            size = STATE_CAPTURE_FIELDS[key]
+            if samples:
+                payload[key] = np.stack(samples, axis=0).astype(np.float32)
+            else:
+                payload[key] = np.empty((0, size), dtype=np.float32)
+        for key, samples in self.scalars.items():
+            payload[key] = np.asarray(samples, dtype=np.float64)
+        np.savez_compressed(self.path, **payload)
+        print(_green(f"Saved replay g1_debug capture: {self.path} ({len(self.replay_frame_index)} samples)"))
+
+
+def _validate_pose_wire_initial_identity(
+    baseline_row: pd.Series,
+    candidate_row: pd.Series,
+) -> None:
+    """Require a candidate POSE replay to begin with the exact baseline wire."""
+
+    required = (
+        "teleop.smpl_pose",
+        "teleop.smpl_joints",
+        "teleop.body_quat_w",
+        "teleop.vr_3pt_position",
+        "teleop.vr_3pt_orientation",
+        "teleop.left_wrist_joints",
+        "teleop.right_wrist_joints",
+        "teleop.left_hand_joints",
+        "teleop.right_hand_joints",
+    )
+    missing = [
+        name
+        for name in required
+        if name not in baseline_row.index or name not in candidate_row.index
+    ]
+    if missing:
+        raise ValueError(
+            "strict POSE baseline pre-align is missing wire fields: "
+            + ", ".join(missing)
+        )
+    mismatches: list[str] = []
+    for name in required:
+        baseline_value = np.asarray(baseline_row[name])
+        candidate_value = np.asarray(candidate_row[name])
+        if (
+            baseline_value.shape != candidate_value.shape
+            or not np.array_equal(baseline_value, candidate_value)
+        ):
+            mismatches.append(name)
+    if mismatches:
+        raise ValueError(
+            "candidate row 0 is not byte-identical to baseline POSE wire: "
+            + ", ".join(mismatches)
+        )
+

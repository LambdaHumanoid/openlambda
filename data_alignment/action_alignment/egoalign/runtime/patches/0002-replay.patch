+@dataclass
+class DeploySupervisorRequestChannel:
+    """One-run file handshake used to request a fresh per-attempt deploy."""
+
+    active_path: Path
+    request_path: Path
+    active_token: str
+    closed: bool = False
+
+    @classmethod
+    def open(
+        cls,
+        active_path: str | Path,
+        request_path: str | Path,
+    ) -> "DeploySupervisorRequestChannel":
+        active = absolute_path_preserving_symlink(active_path)
+        request = absolute_path_preserving_symlink(request_path)
+        if active == request:
+            raise ValueError("deploy supervisor active/request paths must differ")
+        if active.parent != request.parent:
+            raise ValueError(
+                "deploy supervisor active/request paths must share one unique run directory"
+            )
+        if active.is_symlink() or request.is_symlink():
+            raise ValueError("deploy supervisor sentinel paths must not be symlinks")
+        try:
+            active_token = active.read_text(encoding="utf-8").strip()
+        except FileNotFoundError as exc:
+            raise RuntimeError(
+                f"deploy supervisor is not active: missing {active}"
+            ) from exc
+        if not active_token:
+            raise RuntimeError(f"deploy supervisor active token is empty: {active}")
+        inflight = Path(f"{request}.inflight")
+        if request.exists() or inflight.exists():
+            raise RuntimeError(
+                "deploy supervisor request channel is stale/busy: "
+                f"{request} or {inflight} already exists"
+            )
+        return cls(
+            active_path=active,
+            request_path=request,
+            active_token=active_token,
+        )
+
+    @property
+    def inflight_path(self) -> Path:
+        return Path(f"{self.request_path}.inflight")
+
+    def wait_until_idle(self, timeout_s: float) -> None:
+        """Wait for the prior attempt to be fully retired by the supervisor."""
+
+        deadline = time.monotonic() + timeout_s
+        while time.monotonic() < deadline:
+            try:
+                current_token = self.active_path.read_text(encoding="utf-8").strip()
+            except FileNotFoundError as exc:
+                raise RuntimeError(
+                    f"deploy supervisor exited while retiring prior attempt: "
+                    f"{self.active_path}"
+                ) from exc
+            if current_token != self.active_token:
+                raise RuntimeError(
+                    "deploy supervisor active token changed while retiring prior attempt"
+                )
+            if not self.request_path.exists() and not self.inflight_path.exists():
+                return
+            time.sleep(0.05)
+        raise TimeoutError(
+            "deploy supervisor did not retire the prior request within "
+            f"{timeout_s:g}s: request={self.request_path.exists()}, "
+            f"inflight={self.inflight_path.exists()}"
+        )
+
+    def request(self, *, episode_index: int, attempt: int) -> dict[str, Any]:
+        """Publish a complete request atomically without replacing stale state."""
+
+        if self.closed:
+            raise RuntimeError("deploy supervisor request channel is closed")
+        try:
+            current_token = self.active_path.read_text(encoding="utf-8").strip()
+        except FileNotFoundError as exc:
+            raise RuntimeError(
+                f"deploy supervisor exited before request: {self.active_path}"
+            ) from exc
+        if current_token != self.active_token:
+            raise RuntimeError(
+                "deploy supervisor active token changed; refusing to reuse sentinels"
+            )
+        if self.request_path.exists() or self.inflight_path.exists():
+            raise RuntimeError(
+                "previous deploy request was not consumed; refusing to start replayer"
+            )
+
+        payload = {
+            "active_token": self.active_token,
+            "episode_index": int(episode_index),
+            "attempt": int(attempt),
+            "request_monotonic_ns": time.monotonic_ns(),
+            "request_pid": os.getpid(),
+        }
+        temporary_path = self.request_path.parent / (
+            f".{self.request_path.name}.{os.getpid()}.{time.monotonic_ns()}.tmp"
+        )
+        descriptor = os.open(
+            temporary_path,
+            os.O_WRONLY | os.O_CREAT | os.O_EXCL,
+            0o600,
+        )
+        try:
+            with os.fdopen(descriptor, "w", encoding="utf-8") as file:
+                json.dump(payload, file, ensure_ascii=False, sort_keys=True)
+                file.write("\n")
+                file.flush()
+                os.fsync(file.fileno())
+            # Hard-linking a fully written inode is atomic and, unlike rename,
+            # fails rather than overwriting a stale unconsumed request.
+            os.link(temporary_path, self.request_path)
+        finally:
+            try:
+                temporary_path.unlink()
+            except FileNotFoundError:
+                pass
+
+        try:
+            current_token = self.active_path.read_text(encoding="utf-8").strip()
+        except FileNotFoundError:
+            current_token = ""
+        if current_token != self.active_token:
+            try:
+                self.request_path.unlink()
+            except FileNotFoundError:
+                pass
+            raise RuntimeError(
+                "deploy supervisor exited while publishing request; "
+                "refusing to start replayer"
+            )
+        return payload
+
+    def close(self) -> None:
+        """Tell the run-local supervisor to exit without touching other runs."""
+
+        if self.closed:
+            return
+        self.closed = True
+        try:
+            current_token = self.active_path.read_text(encoding="utf-8").strip()
+        except FileNotFoundError:
+            current_token = ""
+        if current_token == self.active_token:
+            self.active_path.unlink(missing_ok=True)
+        self.request_path.unlink(missing_ok=True)
+

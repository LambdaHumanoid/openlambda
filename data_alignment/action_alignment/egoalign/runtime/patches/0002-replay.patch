+    def apply_body_joint_velocity_impulse(
+        self, joint_index: int, delta_rad_s: float
+    ) -> dict[str, object]:
+        """Apply one diagnostic instantaneous ``dq`` change to a body joint.
+
+        This is exposed only through the explicit simulation-control command;
+        normal simulation and deploy paths never call it.  The bounded delta
+        lets deterministic replay reproduce a measured contact disturbance
+        without overwriting the simulated state on later ticks.
+        """
+
+        index = int(joint_index)
+        delta = float(delta_rad_s)
+        if index < 0 or index >= len(self.body_joint_index):
+            raise ValueError(
+                f"body joint index must be in [0,{len(self.body_joint_index) - 1}]"
+            )
+        if not np.isfinite(delta) or abs(delta) > 20.0:
+            raise ValueError("joint velocity impulse must be finite and within 20 rad/s")
+
+        joint_id = int(self.body_joint_index[index])
+        dof_address = int(self.mj_model.jnt_dofadr[joint_id])
+        before = float(self.mj_data.qvel[dof_address])
+        self.mj_data.qvel[dof_address] = before + delta
+        mujoco.mj_forward(self.mj_model, self.mj_data)
+        return {
+            "status": "ok",
+            "joint_index": index,
+            "joint_name": str(_BODY_JOINT_NAMES[index]),
+            "delta_rad_s": delta,
+            "before_rad_s": before,
+            "after_rad_s": float(self.mj_data.qvel[dof_address]),
+        }
+
+    def apply_body_joint_velocity_impulse_vector(
+        self,
+        delta_rad_s: list[float] | np.ndarray,
+        *,
+        observation_hold_ms: float = 0.0,
+        observation_residual_rad_s: list[float] | np.ndarray | None = None,
+    ) -> dict[str, object]:
+        """Apply a physical dq impulse and an optional observation residual.
+
+        The two vectors are intentionally separate for saved-real-event
+        replay: position differences support the physical velocity change,
+        while the remaining instantaneous encoder-velocity disagreement is
+        exposed only in the simulated LowState observation.  Normal simulation
+        and deployment paths never call this diagnostic API.
+        """
+
+        delta = np.asarray(delta_rad_s, dtype=np.float64).reshape(-1)
+        hold_ms = float(observation_hold_ms)
+        if delta.shape != (len(self.body_joint_index),):
+            raise ValueError(
+                "body joint velocity impulse vector must contain exactly "
+                f"{len(self.body_joint_index)} values"
+            )
+        if not np.isfinite(delta).all() or np.any(np.abs(delta) > 20.0):
+            raise ValueError(
+                "joint velocity impulse vector must be finite and within 20 rad/s"
+            )
+        if not np.isfinite(hold_ms) or not 0.0 <= hold_ms <= 20.0:
+            raise ValueError("observation hold must be finite and within 0..20 ms")
+        observation_residual = None
+        if observation_residual_rad_s is not None:
+            observation_residual = np.asarray(
+                observation_residual_rad_s, dtype=np.float64
+            ).reshape(-1)
+            if observation_residual.shape != (len(self.body_joint_index),):
+                raise ValueError(
+                    "body joint velocity observation residual must contain "
+                    f"exactly {len(self.body_joint_index)} values"
+                )
+            if not np.isfinite(observation_residual).all() or np.any(
+                np.abs(observation_residual) > 20.0
+            ):
+                raise ValueError(
+                    "joint velocity observation residual must be finite and "
+                    "within 20 rad/s"
+                )
+            if hold_ms <= 0.0:
+                raise ValueError(
+                    "a velocity observation residual requires a positive hold"
+                )
+
+        joint_ids = np.asarray(self.body_joint_index, dtype=np.int64)
+        dof_addresses = np.asarray(
+            self.mj_model.jnt_dofadr[joint_ids], dtype=np.int64
+        )
+        before = np.asarray(self.mj_data.qvel[dof_addresses], dtype=np.float64).copy()
+        self.mj_data.qvel[dof_addresses] = before + delta
+        mujoco.mj_forward(self.mj_model, self.mj_data)
+        after = np.asarray(
+            self.mj_data.qvel[dof_addresses], dtype=np.float64
+        ).copy()
+        if hold_ms > 0.0:
+            self._diagnostic_body_dq_observation = after.copy()
+            if observation_residual is not None:
+                self._diagnostic_body_dq_observation += observation_residual
+            self._diagnostic_body_dq_observation_until = (
+                time.monotonic() + hold_ms * 1e-3
+            )
+        else:
+            self._diagnostic_body_dq_observation = None
+            self._diagnostic_body_dq_observation_until = 0.0
+        return {
+            "status": "ok",
+            "nonzero_joint_count": int(np.count_nonzero(delta)),
+            "max_abs_delta_rad_s": float(np.max(np.abs(delta))),
+            "delta_rad_s": delta.tolist(),
+            "before_rad_s": before.tolist(),
+            "after_rad_s": after.tolist(),
+            "observation_hold_ms": hold_ms,
+            "max_abs_observation_residual_rad_s": (
+                0.0
+                if observation_residual is None
+                else float(np.max(np.abs(observation_residual)))
+            ),
+        }
+
+    def seed_diagnostic_state(
+        self,
+        *,
+        root_position: list[float] | np.ndarray,
+        root_quaternion_wxyz: list[float] | np.ndarray,
+        root_linear_velocity: list[float] | np.ndarray,
+        root_angular_velocity: list[float] | np.ndarray,
+        body_joint_position: list[float] | np.ndarray,
+        body_joint_velocity: list[float] | np.ndarray,
+    ) -> dict[str, object]:
+        """Atomically seed one bounded free-base state for diagnostic replay.
+
+        Normal simulation and deployment never call this method.  It exists so
+        a saved real-robot event can be replayed from exactly the same MuJoCo
+        state in paired baseline/candidate trials.  Support must already be
+        released; otherwise the elastic force would immediately invalidate the
+        seeded state.
+        """

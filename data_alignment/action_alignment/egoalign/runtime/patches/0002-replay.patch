+def _optional_vector(row, key: str, expected_size: int) -> np.ndarray | None:
+    val = row.get(key, None)
+    if val is None:
+        return None
+    arr = np.asarray(val, dtype=np.float32).reshape(-1)
+    if arr.size != expected_size:

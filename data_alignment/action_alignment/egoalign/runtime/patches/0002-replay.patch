+def _rot6d_to_quat_wxyz(rot6d: np.ndarray) -> np.ndarray:
+    rot = np.asarray(rot6d, dtype=np.float64).reshape(-1, 6)
+    a1 = rot[:, :3]
+    a2 = rot[:, 3:6]
+    b1 = a1 / np.linalg.norm(a1, axis=1, keepdims=True).clip(min=1e-8)
+    a2_orth = a2 - np.sum(b1 * a2, axis=1, keepdims=True) * b1
+    b2 = a2_orth / np.linalg.norm(a2_orth, axis=1, keepdims=True).clip(min=1e-8)
+    b3 = np.cross(b1, b2)
+    mats = np.stack([b1, b2, b3], axis=2)
+    from scipy.spatial.transform import Rotation
+
+    return Rotation.from_matrix(mats).as_quat(scalar_first=True).reshape(-1).astype(np.float32)
+
+
+def _optional_vr3pt_orientation(row) -> np.ndarray | None:
+    val = row.get("teleop.vr_3pt_orientation", None)
+    if val is None:
+        return None
+    arr = np.asarray(val, dtype=np.float32).reshape(-1)
+    if arr.size == 12 and np.isfinite(arr).all():
+        return arr
+    if arr.size == 18 and np.isfinite(arr).all():
+        if float(np.linalg.norm(arr)) <= 1e-8:
+            return None
+        return _rot6d_to_quat_wxyz(arr)
+    return None
+

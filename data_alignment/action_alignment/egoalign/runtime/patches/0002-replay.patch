+class _SimulationBodyPlant:
+    """Optional simulation-only command delay and actuator response mismatch.
+
+    The production/default path does not instantiate this helper.  It exists
+    only to make isolated MuJoCo stress tests less ideal than the stock direct
+    torque actuator, so recorded hardware disturbances can be evaluated in a
+    closed loop before any candidate mitigation reaches the robot.
+    """
+
+    def __init__(
+        self,
+        *,
+        num_joints: int,
+        sim_dt_s: float,
+        command_delay_ms: float,
+        torque_time_constant_ms: float,
+        torque_scale: float,
+    ) -> None:
+        values = np.asarray(
+            [sim_dt_s, command_delay_ms, torque_time_constant_ms, torque_scale],
+            dtype=np.float64,
+        )
+        if not np.isfinite(values).all() or sim_dt_s <= 0.0:
+            raise ValueError("simulation body-plant parameters must be finite")
+        if not 0.0 <= command_delay_ms <= 60.0:
+            raise ValueError("simulation body command delay must be within 0..60 ms")
+        if not 0.0 <= torque_time_constant_ms <= 100.0:
+            raise ValueError(
+                "simulation body torque time constant must be within 0..100 ms"
+            )
+        if not 0.5 <= torque_scale <= 1.5:
+            raise ValueError("simulation body torque scale must be within 0.5..1.5")
+
+        self.num_joints = int(num_joints)
+        self.sim_dt_s = float(sim_dt_s)
+        self.command_delay_ms = float(command_delay_ms)
+        self.command_delay_steps = int(
+            round(self.command_delay_ms * 1e-3 / self.sim_dt_s)
+        )
+        self.torque_time_constant_ms = float(torque_time_constant_ms)
+        self.torque_time_constant_s = self.torque_time_constant_ms * 1e-3
+        self.torque_scale = float(torque_scale)
+        self._command_queue: list[np.ndarray] = []
+        self._filtered_torque: np.ndarray | None = None
+
+    def reset(self) -> None:
+        self._command_queue.clear()
+        self._filtered_torque = None
+
+    def step(
+        self,
+        command: np.ndarray,
+        measured_q: np.ndarray,
+        measured_dq: np.ndarray,
+    ) -> np.ndarray:
+        """Return stressed torque for one physics tick.
+
+        ``command`` columns are ``tau_ff, kp, q, kd, dq``.  The initial
+        command fills the delay line so enabling delay never creates an
+        artificial zero-command transient at episode startup.
+        """
+
+        snapshot = np.asarray(command, dtype=np.float64)
+        q = np.asarray(measured_q, dtype=np.float64)
+        dq = np.asarray(measured_dq, dtype=np.float64)
+        if snapshot.shape != (self.num_joints, 5):
+            raise ValueError("body command must have shape [num_joints,5]")
+        if q.shape != (self.num_joints,) or dq.shape != (self.num_joints,):
+            raise ValueError("body state must have shape [num_joints]")
+        if not np.isfinite(snapshot).all() or not np.isfinite(q).all() or not np.isfinite(dq).all():
+            raise ValueError("body command and state must be finite")
+
+        if not self._command_queue:
+            self._command_queue = [
+                snapshot.copy() for _ in range(self.command_delay_steps + 1)
+            ]
+        else:
+            self._command_queue.append(snapshot.copy())
+            del self._command_queue[: -self.command_delay_steps - 1]
+        delayed = self._command_queue[0]
+        desired_torque = self.torque_scale * (
+            delayed[:, 0]
+            + delayed[:, 1] * (delayed[:, 2] - q)
+            + delayed[:, 3] * (delayed[:, 4] - dq)
+        )
+
+        if self.torque_time_constant_s <= 0.0:
+            return desired_torque
+        if self._filtered_torque is None:
+            self._filtered_torque = desired_torque.copy()
+        else:
+            alpha = 1.0 - np.exp(-self.sim_dt_s / self.torque_time_constant_s)
+            self._filtered_torque += alpha * (
+                desired_torque - self._filtered_torque
+            )
+        return self._filtered_torque.copy()
+

+def main() -> int:
+    args = parse_args()
+    if (
+        args.limit < 0
+        or args.max_frames < 0
+        or args.retries < 0
+        or args.planner_settle_ticks < 0
+    ):
+        raise ValueError(
+            "--limit, --max-frames, --retries and --planner-settle-ticks "
+            "must be non-negative"
+        )
+    if args.rate < 0:
+        raise ValueError("--rate must be non-negative")
+    if args.deploy_exit_timeout <= 0:
+        raise ValueError("--deploy-exit-timeout must be positive")
+    if (
+        args.sim_stability_timeout <= 0
+        or args.sim_stability_poll_hz <= 0
+        or args.sim_stability_hold_seconds < 0
+        or args.sim_max_root_linear_speed < 0
+        or args.sim_max_root_angular_speed < 0
+        or args.sim_max_body_joint_speed < 0
+    ):
+        raise ValueError(
+            "MuJoCo stability timeout/poll rate must be positive and "
+            "hold/motion thresholds must be non-negative"
+        )
+    if args.sim_prepared_before_deploy and args.reset_sim:
+        raise ValueError(
+            "--sim-prepared-before-deploy requires --no-reset-sim; "
+            "resetting after deploy startup violates the episode lifecycle"
+        )
+    supervisor_paths = (
+        args.deploy_supervisor_active_file,
+        args.deploy_supervisor_request_file,
+    )
+    if args.sim_prepared_before_deploy and any(path is None for path in supervisor_paths):
+        raise ValueError(
+            "--sim-prepared-before-deploy requires both "
+            "--deploy-supervisor-active-file and "
+            "--deploy-supervisor-request-file"
+        )
+    if not args.sim_prepared_before_deploy and any(
+        path is not None for path in supervisor_paths
+    ):
+        raise ValueError(
+            "deploy supervisor sentinel paths are only valid with "
+            "--sim-prepared-before-deploy"
+        )
+    if args.overwrite and args.resume:
+        # Overwrite is an explicit stronger policy.
+        args.resume = False
+
+    deploy_supervisor: DeploySupervisorRequestChannel | None = None
+    if args.sim_prepared_before_deploy:
+        assert args.deploy_supervisor_active_file is not None
+        assert args.deploy_supervisor_request_file is not None
+        deploy_supervisor = DeploySupervisorRequestChannel.open(
+            args.deploy_supervisor_active_file,
+            args.deploy_supervisor_request_file,
+        )
+        # Direct invocations and failures before the episode-loop finally must
+        # still retire this run's supervisor. close() is idempotent.
+        atexit.register(deploy_supervisor.close)
+
+    dataset = discover_dataset(args.dataset_root, args.replay_protocol)
+    selected_indices = parse_episode_selection(args.episodes, dataset.total_episodes)
+    if args.limit > 0:
+        selected_indices = selected_indices[: args.limit]
+    selected = [dataset.episodes[index] for index in selected_indices]
+    rate = args.rate or dataset.fps
+    if rate <= 0:
+        raise ValueError("effective replay rate must be positive")
+
+    output_dir = args.output_dir.expanduser().resolve()
+    write_video = replay_video_enabled()
+    log_dir = output_dir / "logs"
+    telemetry_dir = output_dir / "telemetry"
+    output_dir.mkdir(parents=True, exist_ok=True)
+    log_dir.mkdir(parents=True, exist_ok=True)
+    telemetry_dir.mkdir(parents=True, exist_ok=True)
+    manifest_path = output_dir / "manifest.jsonl"
+    summary_path = output_dir / "summary.json"
+    previous_rollout_contract_valid = False
+    if summary_path.is_file():
+        try:
+            previous_summary = _read_json(summary_path)
+            previous_rollout_contract_valid = rollout_summary_contract_is_current(
+                previous_summary
+            )
+        except ValueError:
+            previous_rollout_contract_valid = False
+    if args.overwrite and manifest_path.exists():
+        manifest_path.unlink()
+
+    print(f"Dataset: {dataset.root}")
+    print(
+        f"Episodes: {len(selected)}/{dataset.total_episodes}; dataset fps={dataset.fps}; "
+        f"replay rate={rate}; output={output_dir}; "
+        f"artifacts={'video+telemetry' if write_video else 'telemetry-only'}"
+    )
+    protocol_counts: dict[str, int] = {}
+    for episode in selected:
+        protocol_counts[episode.protocol] = protocol_counts.get(episode.protocol, 0) + 1
+    print(f"Protocols: {protocol_counts}")
+    if args.sim_prepared_before_deploy:
+        print(f"Lifecycle: {SIM_EPISODE_LIFECYCLE_CONTRACT}")
+
+    if args.dry_run:
+        for episode in selected:
+            print(
+                f"  episode {episode.episode_index:06d}: rows={episode.length}, "
+                f"protocol={episode.protocol}, path={episode.parquet_path}"
+            )
+        return 0
+
+    recorder_status = wait_for_sim_recorder(
+        output_dir,
+        host=args.sim_control_host,
+        port=args.sim_control_port,
+        timeout_s=args.sim_ready_timeout,
+    )

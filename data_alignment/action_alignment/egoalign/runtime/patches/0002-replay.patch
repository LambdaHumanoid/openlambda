+def _send_sim_control(
+    host: str,
+    port: int,
+    command: str,
+    timeout_s: float,
+) -> dict[str, Any]:
+    context = zmq.Context()
+    socket = context.socket(zmq.REQ)
+    timeout_ms = max(1, int(round(timeout_s * 1000.0)))
+    socket.setsockopt(zmq.RCVTIMEO, timeout_ms)
+    socket.setsockopt(zmq.SNDTIMEO, timeout_ms)
+    socket.setsockopt(zmq.LINGER, 0)
+    try:
+        socket.connect(f"tcp://{host}:{port}")
+        socket.send_string(command)
+        raw_reply = socket.recv_string()
+    finally:
+        socket.close(0)
+        context.term()
+    try:
+        reply = json.loads(raw_reply)
+    except json.JSONDecodeError as exc:
+        raise RuntimeError(f"invalid sim-control reply for {command!r}: {raw_reply!r}") from exc
+    if not isinstance(reply, dict):
+        raise RuntimeError(f"invalid sim-control payload for {command!r}: {reply!r}")
+    if reply.get("status") == "error":
+        raise RuntimeError(str(reply.get("error", "sim-control error")))
+    return reply
+
+
+def wait_for_sim_recorder(
+    output_dir: Path,
+    *,
+    host: str,
+    port: int,
+    timeout_s: float,
+) -> dict[str, Any]:
+    deadline = time.monotonic() + timeout_s
+    last_error = "no reply"
+    while time.monotonic() < deadline:
+        try:
+            status = _send_sim_control(host, port, "replay_video:status", 2.0)
+            if not status.get("available"):
+                raise RuntimeError("sim recorder is not configured")
+            actual_output = Path(str(status.get("output_dir"))).resolve()
+            if actual_output != output_dir.resolve():
+                raise RuntimeError(
+                    f"sim recorder output mismatch: expected {output_dir}, got {actual_output}"
+                )
+            return status
+        except Exception as exc:
+            last_error = str(exc)
+            time.sleep(0.5)
+    raise RuntimeError(
+        f"MuJoCo replay recorder was not ready on tcp://{host}:{port} "
+        f"within {timeout_s:g}s: {last_error}"
+    )
+
+
+def wait_for_tcp_endpoint_down(host: str, port: int, timeout_s: float) -> None:
+    """Wait until the per-episode C++ deploy has released its ZMQ output port."""
+
+    deadline = time.monotonic() + timeout_s
+    while time.monotonic() < deadline:
+        try:
+            with socket.create_connection((host, port), timeout=0.2):
+                pass
+        except OSError:
+            return
+        time.sleep(0.05)
+    raise TimeoutError(
+        f"fresh deploy barrier timed out: tcp://{host}:{port} never went down "
+        f"within {timeout_s:g}s"
+    )
+
+
+def probe_video(path: Path) -> dict[str, Any]:
+    if not path.is_file() or path.stat().st_size <= 0:
+        raise ValueError(f"video file is missing or empty: {path}")
+    with av.open(str(path), mode="r") as container:
+        streams = [stream for stream in container.streams if stream.type == "video"]
+        if not streams:
+            raise ValueError(f"MP4 contains no video stream: {path}")
+        stream = streams[0]
+        first_frame = next(container.decode(stream), None)
+        if first_frame is None:
+            raise ValueError(f"MP4 contains no decodable frames: {path}")
+        rate = float(stream.average_rate) if stream.average_rate is not None else None
+        duration_s = None
+        if stream.duration is not None and stream.time_base is not None:
+            duration_s = float(stream.duration * stream.time_base)
+        return {
+            "path": str(path.resolve()),
+            "bytes": int(path.stat().st_size),
+            "width": int(stream.width),
+            "height": int(stream.height),
+            "fps": rate,
+            "frames": int(stream.frames) if stream.frames else None,
+            "duration_s": duration_s,
+        }
+
+
+def validate_episode_video(
+    video: dict[str, Any],
+    *,
+    recorder_status: dict[str, Any],
+    expected_duration_s: float,
+) -> None:
+    expected_width = int(recorder_status["width"])
+    expected_height = int(recorder_status["height"])
+    expected_fps = float(recorder_status["fps"])
+    if (video["width"], video["height"]) != (expected_width, expected_height):
+        raise ValueError(
+            "unexpected video dimensions: "
+            f"{video['width']}x{video['height']} != "
+            f"{expected_width}x{expected_height}"
+        )
+    actual_fps = video.get("fps")
+    if actual_fps is None or abs(float(actual_fps) - expected_fps) > 0.1:
+        raise ValueError(f"unexpected video fps: {actual_fps} != {expected_fps}")
+
+    # The recorder is paced by MuJoCo simulation time while replay is paced by
+    # wall time.  Offscreen rendering can make physics run a few percent slower,
+    # so allow 5% drift while still rejecting materially truncated files.
+    minimum_duration = max(0.0, expected_duration_s * 0.95 - 0.1)
+    actual_duration = video.get("duration_s")
+    if actual_duration is None or float(actual_duration) < minimum_duration:
+        raise ValueError(
+            f"video is truncated: duration={actual_duration}, "
+            f"expected at least {minimum_duration:.3f}s"
+        )
+    actual_frames = video.get("frames")
+    minimum_frames = int(minimum_duration * expected_fps)
+    if actual_frames is not None and int(actual_frames) < minimum_frames:
+        raise ValueError(
+            f"video is truncated: frames={actual_frames}, "
+            f"expected at least {minimum_frames}"
+        )
+
+
+def validate_sim_telemetry(
+    capture: Any,
+    *,
+    expected_duration_s: float,
+    video_frames: int | None,
+) -> dict[str, int | float]:
+    """Reject reset, fall, or truncated MuJoCo captures before quality gating."""
+
+    video_frame_index = np.asarray(capture.video_frame_index, dtype=np.int64)
+    sample_count = len(video_frame_index)
+    if sample_count <= 0:
+        raise ValueError("sim telemetry contains no samples")
+    if video_frames is not None and sample_count != int(video_frames):
+        raise ValueError(
+            "sim telemetry/video frame mismatch: "
+            f"{sample_count} != {video_frames}"
+        )
+
+    fps = float(capture.fps)
+    if not np.isfinite(fps) or fps <= 0:
+        raise ValueError(f"sim telemetry fps is invalid: {fps}")
+    minimum_duration = max(0.0, expected_duration_s * 0.95 - 0.1)
+    maximum_duration = expected_duration_s * 1.05 + 0.1
+    minimum_samples = max(1, int(np.floor(minimum_duration * fps)))
+    maximum_samples = max(1, int(np.ceil(maximum_duration * fps)) + 1)
+    if sample_count < minimum_samples or sample_count > maximum_samples:
+        raise ValueError(
+            "sim telemetry sample count is inconsistent with replay duration: "
+            f"samples={sample_count}, expected range=[{minimum_samples}, "
+            f"{maximum_samples}]"
+        )
+
+    sim_time_s = np.asarray(capture.sim_time_s, dtype=np.float64)
+    if sim_time_s.shape != (sample_count,) or not np.isfinite(sim_time_s).all():
+        raise ValueError("sim telemetry sim_time_s is missing or non-finite")
+    if sample_count > 1 and np.any(np.diff(sim_time_s) <= 0):
+        raise ValueError(
+            "sim telemetry sim_time_s is not strictly increasing "
+            "(MuJoCo reset/freeze during formal replay)"
+        )
+    sim_duration_s = float(sim_time_s[-1] - sim_time_s[0])
+    # N samples span N-1 intervals; allow that one-frame endpoint difference.
+    minimum_sim_duration = max(0.0, minimum_duration - 1.0 / fps)
+    maximum_sim_duration = maximum_duration + 1.0 / fps
+    if (
+        sim_duration_s < minimum_sim_duration
+        or sim_duration_s > maximum_sim_duration
+    ):
+        raise ValueError(
+            "sim telemetry duration is inconsistent with replay duration: "
+            f"duration={sim_duration_s:.3f}s, expected range="
+            f"[{minimum_sim_duration:.3f}, {maximum_sim_duration:.3f}]s"
+        )
+
+    monotonic_ns = np.asarray(capture.monotonic_ns, dtype=np.int64)
+    if monotonic_ns.shape != (sample_count,):
+        raise ValueError("sim telemetry monotonic_ns is missing or invalid")
+    if sample_count > 1 and np.any(np.diff(monotonic_ns) <= 0):
+        raise ValueError("sim telemetry monotonic_ns is not strictly increasing")
+
+    root_position = np.asarray(capture.root_position, dtype=np.float64)
+    if root_position.shape != (sample_count, 3):
+        raise ValueError(
+            "sim telemetry root_position has invalid shape: "
+            f"{root_position.shape} != ({sample_count}, 3)"
+        )
+    if not np.isfinite(root_position).all():
+        raise ValueError("sim telemetry root_position contains non-finite values")
+    minimum_root_height = float(np.min(root_position[:, 2]))
+    if minimum_root_height < MIN_VALID_ROOT_HEIGHT_M:
+        raise ValueError(
+            "sim telemetry contains a fallen robot: "
+            f"minimum root height {minimum_root_height:.3f}m < "
+            f"{MIN_VALID_ROOT_HEIGHT_M:.3f}m"
+        )
+
+    joint_names = tuple(str(name) for name in capture.joint_names)
+    if not joint_names:
+        raise ValueError("sim telemetry contains no named body joints")
+    expected_shapes = {
+        "root_quaternion_wxyz": (sample_count, 4),
+        "root_linear_velocity": (sample_count, 3),
+        "root_angular_velocity": (sample_count, 3),
+        "body_joint_position": (sample_count, len(joint_names)),
+        "body_joint_velocity": (sample_count, len(joint_names)),
+    }
+    for name, expected_shape in expected_shapes.items():
+        values = np.asarray(getattr(capture, name), dtype=np.float64)
+        if values.shape != expected_shape:
+            raise ValueError(
+                f"sim telemetry {name} has invalid shape: "
+                f"{values.shape} != {expected_shape}"
+            )
+        if not np.isfinite(values).all():
+            raise ValueError(f"sim telemetry {name} contains non-finite values")
+
+    quaternion_norm = np.linalg.norm(
+        np.asarray(capture.root_quaternion_wxyz, dtype=np.float64),
+        axis=1,
+    )
+    if np.any(quaternion_norm <= 1e-8):
+        raise ValueError("sim telemetry root_quaternion_wxyz contains a zero quaternion")
+
+    return {
+        "samples": sample_count,
+        "sim_duration_s": sim_duration_s,
+        "minimum_root_height_m": minimum_root_height,
+    }
+

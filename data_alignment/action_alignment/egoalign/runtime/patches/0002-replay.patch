+"""SONIC LeRobot dataset replayer.
+
+Reads a `.parquet` recorded by `gear_sonic/scripts/run_data_exporter.py` and
+publishes ZMQ messages to drive the SONIC C++ deploy (running with
+`--input-type zmq_manager`):
+
+  - `command` topic — start/stop control loop, switch PLANNER vs POSE
+  - `pose` topic    — POSE-mode SMPL frames (mirrors `pico_manager_thread_server`)
+  - `planner` topic — PLANNER-mode locomotion command
+
+Stages:
+  1. Wait for deploy, then wait for terminal Enter before sending SONIC start.
+  2. Wait again before switching to STREAMED_MOTION / POSE.
+  3. Runtime pre-align to first frame: optionally switch into a planner-default
+     POSE anchor first, hold it, then blend that anchor into row 0 for
+     `--ramp-seconds`. This is not data reach-in and is not counted in parquet
+     replay frames.
+  4. Start playback immediately if requested, otherwise wait for terminal Enter (or `q`).
+  5. Step through the parquet at `--rate` Hz, sending one ZMQ message per row.
+  6. Runtime post-replay return to first frame and wait quietly; Enter replays
+     again, `q` exits.
+"""
+
+from collections import deque
+from dataclasses import dataclass
+import atexit
+import json
+import math
+import os
+from pathlib import Path
+import select
+import signal
+import sys
+import time
+
+# This script is launched by run.sh via its file path.  In that execution mode
+# Python puts gear_sonic/scripts, rather than the repository root, on sys.path;
+# make the repository packages importable without requiring a caller-specific
+# PYTHONPATH.  Module execution (python -m ...) already has this path and is
+# therefore unchanged.
+PROJECT_ROOT = Path(__file__).resolve().parents[2]
+if str(PROJECT_ROOT) not in sys.path:
+    sys.path.insert(0, str(PROJECT_ROOT))
+
+import numpy as np
+import pandas as pd
+import tyro
+import zmq
+
+from gear_sonic.utils.data_collection.zmq_state_subscriber import (
+    ZMQStateSubscriber,
+    poll_robot_config_zmq,
+)
+from gear_sonic.utils.teleop.zmq.zmq_planner_sender import (
+    build_command_message,
+    build_planner_message,
+    pack_pose_message,
+)
+from gear_sonic.scripts.replay_timing import replay_sleep_schedule
+from gear_sonic.postprocessing.velocity_quality.schema import (
+    MUJOCO_BODY_JOINT_NAMES,
+    REFERENCE_G1_JOINT_NAMES,
+    SMPL_JOINT_NAMES,
+    TELEMETRY_FORMAT_VERSION,
+)
+from gear_sonic.postprocessing.velocity_quality.telemetry import (
+    ReferenceTelemetryBuffer,
+)
+from gear_sonic.rollout_contract import (
+    INITIAL_BODY_Q_REFERENCE_CONTRACT,
+    STRICT_AB_INITIAL_BODY_Q_MAX_ERROR_DEG,
+    STRICT_AB_INITIAL_BODY_Q_RMS_ERROR_DEG,
+)
+from scripts.human_data.processing.wrist_contract import (
+    interleave_wrist_positions,
+    wrist_positions_to_g1_joint_pos,
+)
+
+
+@dataclass
+class ReplayerConfig:
+    parquet_path: str
+    """Path to the .parquet file produced by run_data_exporter.py."""
+
+    zmq_host: str = "localhost"
+    """ZMQ PUB host to bind."""
+
+    zmq_port: int = 5556
+    """ZMQ PUB port (matches C++ deploy --zmq-port)."""
+
+    state_zmq_host: str = "localhost"
+    """ZMQ host for robot state (g1_debug topic from C++ deploy)."""
+
+    state_zmq_port: int = 5557
+    """ZMQ port for robot state."""
+
+    startup_timeout: float = 30.0
+    """Max seconds to wait for C++ control loop to publish first state after start."""
+
+    planner_settle_ticks: int = 10
+    """Consecutive 50 Hz C++ control ticks required before switching out of PLANNER."""
+
+    rate: int = 50
+    """Replay rate in Hz."""
+
+    ramp_seconds: float = 5.0
+    """Runtime seconds to blend the pre-align anchor into the first replay frame."""
+
+    neutral_pose_blend: bool = True

+"""Episode-scoped video recording for the SONIC MuJoCo simulator."""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+import queue
+import re
+import threading
+import time
+from typing import Callable, Mapping, Protocol
+
+import numpy as np
+
+from gear_sonic.postprocessing.velocity_quality.telemetry import (
+    SimTelemetryBuffer,
+    sim_telemetry_path,
+)
+
+
+_SAFE_VIDEO_STEM = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
+
+
+class _Writer(Protocol):
+    def add_frame(self, frame: np.ndarray) -> None: ...
+
+    def stop(self) -> str: ...
+
+    def cancel(self) -> None: ...
+
+
+WriterFactory = Callable[[str, int, int, float], _Writer]
+
+
+class OpenCVVideoWriter:
+    """Small asynchronous MP4 writer available in the MuJoCo environments."""
+
+    _SENTINEL = object()
+
+    def __init__(
+        self,
+        output_path: str,
+        width: int,
+        height: int,
+        fps: float,
+        *,
+        buffer_size: int = 90,
+    ) -> None:
+        import cv2
+
+        self.output_path = output_path
+        self.width = int(width)
+        self.height = int(height)
+        self._cv2 = cv2
+        self._queue: queue.Queue[np.ndarray | object] = queue.Queue(
+            maxsize=buffer_size
+        )
+        self._closed = False
+        self._cancelled = False
+        self._worker_error: BaseException | None = None
+
+        Path(output_path).parent.mkdir(parents=True, exist_ok=True)
+        self._writer = cv2.VideoWriter(
+            output_path,
+            cv2.VideoWriter_fourcc(*"mp4v"),
+            float(fps),
+            (self.width, self.height),
+        )
+        if not self._writer.isOpened():
+            self._writer.release()
+            raise RuntimeError(f"OpenCV failed to open MP4 writer: {output_path}")
+
+        self._thread = threading.Thread(
+            target=self._writer_worker,
+            name="sonic-replay-video-writer",
+            daemon=True,
+        )
+        self._thread.start()
+
+    def _raise_worker_error(self) -> None:
+        if self._worker_error is not None:
+            raise RuntimeError(
+                f"OpenCV video writer failed: {self._worker_error}"
+            ) from self._worker_error
+
+    def _writer_worker(self) -> None:
+        while True:
+            item = self._queue.get()
+            if item is self._SENTINEL:
+                return
+            if self._cancelled or self._worker_error is not None:
+                continue
+            try:
+                self._writer.write(item)
+            except BaseException as exc:  # surfaced by add_frame()/stop()
+                self._worker_error = exc
+
+    def add_frame(self, frame: np.ndarray) -> None:
+        if self._closed:
+            raise RuntimeError(f"video writer is already closed: {self.output_path}")
+        if frame.shape != (self.height, self.width, 3):
+            raise ValueError(
+                f"frame shape {frame.shape} does not match "
+                f"({self.height}, {self.width}, 3)"
+            )
+        self._raise_worker_error()
+        self._queue.put(frame.copy())
+        self._raise_worker_error()
+
+    def stop(self) -> str:
+        if self._closed:
+            return self.output_path
+        self._queue.put(self._SENTINEL)
+        self._thread.join()
+        self._writer.release()
+        self._closed = True
+        self._raise_worker_error()
+        return self.output_path
+
+    def cancel(self) -> None:
+        if self._closed:
+            return
+        self._cancelled = True
+        self._queue.put(self._SENTINEL)
+        self._thread.join()
+        self._writer.release()
+        self._closed = True
+        try:
+            os.unlink(self.output_path)
+        except FileNotFoundError:
+            pass
+
+
+def _default_writer_factory(path: str, width: int, height: int, fps: float) -> _Writer:
+    return OpenCVVideoWriter(path, width=width, height=height, fps=fps)
+
+
+class ReplayVideoRecorder:
+    """Writes one third-person simulation MP4 at a time.
+
+    The recorder deliberately accepts a filename rather than an arbitrary path.
+    The simulator owns the configured output directory, while the replay process
+    only selects a safe episode filename over the local control socket.
+    """
+
+    def __init__(
+        self,
+        output_dir: str | Path | None,
+        *,
+        width: int = 1280,
+        height: int = 720,
+        fps: float = 30.0,
+        joint_names: tuple[str, ...] = (),
+        write_video: bool = True,
+        writer_factory: WriterFactory = _default_writer_factory,
+    ) -> None:
+        if width <= 0 or height <= 0:
+            raise ValueError("video width and height must be positive")
+        if fps <= 0:
+            raise ValueError("video fps must be positive")
+
+        self.output_dir = Path(output_dir).expanduser().resolve() if output_dir else None
+        self.width = int(width)
+        self.height = int(height)
+        self.fps = float(fps)
+        self.joint_names = tuple(str(name) for name in joint_names)
+        self.write_video = bool(write_video)
+        self._writer_factory = writer_factory
+        self._writer: _Writer | None = None
+        self._telemetry: SimTelemetryBuffer | None = None
+        self._telemetry_path: Path | None = None
+        self._telemetry_samples = 0
+        self._path: Path | None = None
+        self._frame_count = 0
+        self._started_monotonic: float | None = None
+        self._active = False
+
+    @property
+    def available(self) -> bool:
+        return self.output_dir is not None
+
+    @property
+    def recording(self) -> bool:
+        return self._active
+
+    @property
+    def frame_count(self) -> int:
+        return self._frame_count
+
+    @property
+    def path(self) -> Path | None:
+        return self._path
+
+    @staticmethod
+    def normalize_filename(filename: str) -> str:
+        name = filename.strip()
+        if name.lower().endswith(".mp4"):
+            stem = name[:-4]
+        else:
+            stem = name
+            name = f"{name}.mp4"
+        if not stem or not _SAFE_VIDEO_STEM.fullmatch(stem):
+            raise ValueError(
+                "video filename must contain only letters, numbers, '.', '_' or '-'"
+            )
+        return name
+
+    def start(self, filename: str) -> dict[str, object]:
+        if self.output_dir is None:
+            raise RuntimeError("SONIC_REPLAY_VIDEO_DIR is not configured in the simulator")
+        if self._active:
+            raise RuntimeError(f"video recording already active: {self._path}")
+
+        normalized = self.normalize_filename(filename)
+        self.output_dir.mkdir(parents=True, exist_ok=True)
+        path = (self.output_dir / normalized).resolve()
+        if path.parent != self.output_dir:
+            raise ValueError(f"video path escapes configured output directory: {filename}")
+
+        self._writer = (
+            self._writer_factory(str(path), self.width, self.height, self.fps)
+            if self.write_video
+            else None
+        )
+        self._telemetry_path = sim_telemetry_path(self.output_dir, normalized)
+        self._telemetry = (
+            SimTelemetryBuffer(
+                self._telemetry_path,
+                video_name=normalized,
+                fps=self.fps,
+                joint_names=self.joint_names,
+            )
+            if self.joint_names
+            else None
+        )
+        self._telemetry_samples = 0
+        self._path = path
+        self._frame_count = 0
+        self._started_monotonic = time.monotonic()
+        self._active = True
+        return self.status("started")
+
+    def add_rgb_frame(
+        self,
+        frame: np.ndarray,
+        *,
+        telemetry: Mapping[str, object] | None = None,
+    ) -> None:
+        if not self._active:
+            return
+        array = np.asarray(frame)
+        expected_shape = (self.height, self.width, 3)
+        if array.shape != expected_shape:
+            raise ValueError(
+                f"replay frame has shape {array.shape}, expected {expected_shape}"
+            )
+        if array.dtype != np.uint8:
+            array = np.clip(array, 0, 255)
+            if np.issubdtype(array.dtype, np.floating) and float(array.max(initial=0)) <= 1.0:
+                array = array * 255.0
+            array = array.astype(np.uint8)
+
+        if self._writer is not None:
+            # mujoco.Renderer returns RGB; VideoWriter consumes BGR.
+            bgr = np.ascontiguousarray(array[:, :, ::-1])
+            self._writer.add_frame(bgr)
+        if self._telemetry is not None:
+            if telemetry is None:
+                raise ValueError("sim telemetry sample is required for each replay frame")
+            self._telemetry.add(telemetry)
+            self._telemetry_samples = self._telemetry.sample_count
+        self._frame_count += 1
+
+    def stop(self) -> dict[str, object]:
+        if not self._active:
+            return self.status("idle")
+        writer = self._writer
+        telemetry = self._telemetry
+        try:
+            if writer is not None:
+                writer.stop()
+            if telemetry is not None:
+                telemetry.save()
+                self._telemetry_samples = telemetry.sample_count
+        except BaseException:
+            if telemetry is not None:
+                telemetry.cancel()
+            raise
+        finally:
+            self._writer = None
+            self._telemetry = None
+            self._active = False
+        result = self.status("stopped")
+        self._started_monotonic = None
+        return result
+
+    def cancel(self) -> dict[str, object]:
+        # A failed attempt may call cancel before it ever starts recording.
+        # In a multi-episode simulator, _telemetry_path still describes the
+        # last successfully stopped episode; never unlink that historical
+        # sidecar unless this cancel owns an active writer/telemetry buffer.
+        was_recording = self._active
+        if self._writer is not None:
+            writer = self._writer
+            try:
+                writer.cancel()
+            finally:
+                self._writer = None
+        if self._telemetry is not None:
+            self._telemetry.cancel()
+            self._telemetry = None
+        elif was_recording and self._telemetry_path is not None:
+            try:
+                self._telemetry_path.unlink()
+            except FileNotFoundError:
+                pass
+        if not was_recording:
+            return self.status("idle")
+        self._active = False
+        self._telemetry_samples = 0
+        result = self.status("cancelled")
+        self._started_monotonic = None
+        return result
+
+    def close(self) -> dict[str, object]:
+        return self.stop() if self._active else self.status("idle")
+
+    def status(self, state: str | None = None) -> dict[str, object]:
+        elapsed = (
+            max(0.0, time.monotonic() - self._started_monotonic)
+            if self._started_monotonic is not None
+            else 0.0
+        )
+        return {
+            "status": state or ("recording" if self.recording else "idle"),
+            "available": bool(self.available),
+            "output_dir": str(self.output_dir) if self.output_dir is not None else None,
+            "path": str(self._path) if self._path is not None else None,
+            "telemetry_path": (
+                str(self._telemetry_path) if self._telemetry_path is not None else None
+            ),
+            "telemetry_samples": int(self._telemetry_samples),
+            "frames": int(self._frame_count),
+            "fps": float(self.fps),
+            "width": int(self.width),
+            "height": int(self.height),
+            "write_video": bool(self.write_video),
+            "elapsed_s": float(elapsed),
+        }

+    if q.ndim != 2 or q.shape[1] != len(SONIC_DEFAULT_ANGLES):
+        raise ValueError(f"teleop.g1_joint_pos shape should be [N, {len(SONIC_DEFAULT_ANGLES)}], got {q.shape}")

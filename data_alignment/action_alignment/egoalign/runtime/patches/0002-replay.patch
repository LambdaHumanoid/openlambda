@@ -0,0 +1,82 @@
+#!/usr/bin/env python3
+"""Send one command to the long-lived MuJoCo sim-control endpoint."""
+
+from __future__ import annotations
+
+import argparse
+import time
+
+import zmq
+
+
+def send_sim_control_command(
+    host: str,
+    port: int,
+    command: str,
+    *,
+    timeout_s: float,
+) -> str:
+    context = zmq.Context()
+    socket = context.socket(zmq.REQ)
+    timeout_ms = max(1, int(round(timeout_s * 1000.0)))
+    socket.setsockopt(zmq.RCVTIMEO, timeout_ms)
+    socket.setsockopt(zmq.SNDTIMEO, timeout_ms)
+    socket.setsockopt(zmq.LINGER, 0)
+    try:
+        socket.connect(f"tcp://{host}:{port}")
+        socket.send_string(command)
+        return socket.recv_string()
+    finally:
+        socket.close(0)
+        context.term()
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("command")
+    parser.add_argument("--host", default="localhost")
+    parser.add_argument("--port", type=int, default=5562)
+    parser.add_argument("--timeout", type=float, default=30.0)
+    parser.add_argument("--retries", type=int, default=10)
+    parser.add_argument("--retry-delay", type=float, default=0.5)
+    parser.add_argument(
+        "--expect",
+        default="",
+        help="Fail unless this text occurs in the reply.",
+    )
+    return parser.parse_args()
+
+
+def main() -> int:
+    args = parse_args()
+    if args.timeout <= 0 or args.retries < 0 or args.retry_delay < 0:
+        raise ValueError("--timeout must be positive; retries/delay must be non-negative")
+
+    last_error = "no attempt"
+    for attempt in range(args.retries + 1):
+        try:
+            reply = send_sim_control_command(
+                args.host,
+                args.port,
+                args.command,
+                timeout_s=args.timeout,
+            )
+            if args.expect and args.expect not in reply:
+                raise RuntimeError(
+                    f"reply does not contain {args.expect!r}: {reply!r}"
+                )
+            print(reply, flush=True)
+            return 0
+        except Exception as exc:
+            last_error = str(exc)
+            if attempt < args.retries:
+                time.sleep(args.retry_delay)
+
+    raise RuntimeError(
+        f"sim-control command {args.command!r} failed on "
+        f"tcp://{args.host}:{args.port}: {last_error}"
+    )
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

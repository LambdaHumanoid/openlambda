+def validate_control_telemetry(path: Path, expected_frames: int) -> dict[str, int]:
+    with np.load(path, allow_pickle=False) as data:
+        format_version = (
+            int(np.asarray(data["format_version"]).item())
+            if "format_version" in data.files
+            else 0
+        )
+        if format_version >= 3:
+            if "measured_joint_names" not in data.files:
+                raise ValueError(
+                    "control telemetry format v3 is missing measured_joint_names"
+                )
+            measured_names = tuple(
+                str(value) for value in data["measured_joint_names"]
+            )
+            if measured_names != tuple(MUJOCO_BODY_JOINT_NAMES):
+                raise ValueError(
+                    "control telemetry measured joint order is not MuJoCo order"
+                )
+        replay_frame_index = np.asarray(data["replay_frame_index"], dtype=np.int32)
+        expected_index = np.arange(expected_frames, dtype=np.int32)
+        if not np.array_equal(replay_frame_index, expected_index):
+            raise ValueError(
+                "control telemetry does not cover every replay frame: "
+                f"samples={len(replay_frame_index)}, expected={expected_frames}"
+            )
+        for key, width in (
+            ("body_q", 29),
+            ("body_dq", 29),
+            ("base_quat", 4),
+            ("base_ang_vel", 3),
+            ("policy_action", 29),
+            ("token_state", 64),
+            ("left_hand_q", 7),
+            ("right_hand_q", 7),
+        ):
+            values = np.asarray(data[key], dtype=np.float64)
+            if values.shape != (expected_frames, width):
+                raise ValueError(
+                    f"control telemetry {key} shape={values.shape}, "
+                    f"expected=({expected_frames}, {width})"
+                )
+            if not np.isfinite(values).all():
+                raise ValueError(f"control telemetry {key} contains non-finite values")
+        control_index = np.asarray(data["index"], dtype=np.float64)
+        if control_index.shape != (expected_frames,) or not np.isfinite(control_index).all():
+            raise ValueError("control telemetry index is missing or invalid")
+        control_steps = np.diff(control_index)
+        if np.any(control_steps != 1.0):
+            unique_steps, counts = np.unique(control_steps, return_counts=True)
+            step_summary = {
+                float(step): int(count)
+                for step, count in zip(unique_steps, counts)
+            }
+            raise ValueError(
+                "control telemetry is not exactly one C++ tick per replay row: "
+                f"steps={step_summary}"
+            )
+        local_frame_index = np.asarray(data["local_frame_index"], dtype=np.int64)
+        if local_frame_index.shape != (expected_frames,):
+            raise ValueError("control telemetry local_frame_index is missing or invalid")
+        if np.any(np.diff(local_frame_index) != 1):
+            raise ValueError("control telemetry sender frame index is not consecutive")
+        capture_time = np.asarray(data["capture_monotonic_ns"], dtype=np.int64)
+        if capture_time.shape != (expected_frames,):
+            raise ValueError("control telemetry capture timestamps are missing or invalid")
+        if np.any(np.diff(capture_time) <= 0):
+            raise ValueError("control telemetry capture timestamps are not increasing")
+    return {"samples": expected_frames, "duplicate_control_ticks": 0}
+
+
+def resolve_strict_ab_initialization(
+    dataset_root: Path,
+    episode_index: int,
+) -> StrictABInitialization | None:
+    """Resolve and hash-check optional baseline/candidate init companions."""
+
+    strict_root = dataset_root / STRICT_AB_DIR
+    baseline_ramp = (
+        strict_root / "baseline_ramp" / f"episode_{episode_index:06d}.parquet"
+    )
+    initial_body_q = (
+        strict_root / "initial_body_q" / f"episode_{episode_index:06d}.npz"
+    )
+    manifest_path = strict_root / "manifest.json"
+    present = (
+        baseline_ramp.is_file(),
+        initial_body_q.is_file(),
+        manifest_path.is_file(),
+    )
+    if not any(present):
+        return None
+    if not all(present):
+        raise ValueError(
+            "strict A/B replay companions are incomplete for episode "
+            f"{episode_index:06d}: baseline={present[0]}, body_q={present[1]}, "
+            f"manifest={present[2]}"
+        )
+
+    manifest = _read_json(manifest_path)
+    if (
+        manifest.get("format_version") != 1
+        or manifest.get("contract") != STRICT_AB_INITIALIZATION_CONTRACT
+        or not isinstance(manifest.get("items"), list)
+    ):
+        raise ValueError(f"invalid strict A/B manifest: {manifest_path}")
+    matches = [
+        item
+        for item in manifest["items"]
+        if isinstance(item, dict)
+        and int(item.get("episode_index", -1)) == int(episode_index)
+    ]
+    if len(matches) != 1:
+        raise ValueError(
+            "strict A/B manifest must contain exactly one item for episode "
+            f"{episode_index:06d}"
+        )
+    item = matches[0]
+    baseline_sha = sha256_file(baseline_ramp)
+    reference_sha = sha256_file(initial_body_q)
+    expected_baseline_sha = item.get("baseline_ramp_sha256")
+    expected_reference_sha = item.get(
+        "initial_body_q_reference_sha256",
+        item.get("body_q_reference_sha256"),
+    )
+    if baseline_sha != expected_baseline_sha or reference_sha != expected_reference_sha:
+        raise ValueError(
+            "strict A/B companion hash mismatch for episode "
+            f"{episode_index:06d}"
+        )
+    try:
+        with np.load(initial_body_q, allow_pickle=False) as payload:
+            baseline_control_sha = str(
+                np.asarray(payload["baseline_control_sha256"]).item()
+            )
+    except (KeyError, OSError, TypeError, ValueError) as exc:
+        raise ValueError(
+            f"invalid strict A/B initial body-q reference: {initial_body_q}"
+        ) from exc
+    if baseline_control_sha != item.get("baseline_control_sha256"):
+        raise ValueError(
+            "strict A/B baseline control provenance mismatch for episode "
+            f"{episode_index:06d}"
+        )
+    return StrictABInitialization(
+        baseline_ramp=baseline_ramp,
+        initial_body_q=initial_body_q,
+        contract={
+            "contract": STRICT_AB_INITIALIZATION_CONTRACT,
+            "baseline_ramp_sha256": baseline_sha,
+            "initial_body_q_reference_sha256": reference_sha,
+            "baseline_control_sha256": baseline_control_sha,
+            "max_wrapped_joint_error_deg": STRICT_AB_INITIAL_BODY_Q_MAX_ERROR_DEG,
+            "rms_wrapped_joint_error_deg": STRICT_AB_INITIAL_BODY_Q_RMS_ERROR_DEG,
+        },
+    )
+

@@ -0,0 +1,127 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+usage() {
+  cat <<'EOF'
+Usage: run_batch_deploy_supervisor.sh \
+  --active-file PATH --request-file PATH \
+  --prepare-command CMD --deploy-command CMD [--restart-delay SECONDS]
+
+Wait for one atomic request per batch attempt, reset MuJoCo, then launch exactly
+one fresh SONIC deploy. Sentinel paths must belong to one unique run directory.
+EOF
+}
+
+active_file=""
+request_file=""
+prepare_command=""
+deploy_command=""
+restart_delay="2"
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --active-file)
+      active_file="${2:-}"
+      shift 2
+      ;;
+    --request-file)
+      request_file="${2:-}"
+      shift 2
+      ;;
+    --prepare-command)
+      prepare_command="${2:-}"
+      shift 2
+      ;;
+    --deploy-command)
+      deploy_command="${2:-}"
+      shift 2
+      ;;
+    --restart-delay)
+      restart_delay="${2:-}"
+      shift 2
+      ;;
+    -h|--help)
+      usage
+      exit 0
+      ;;
+    *)
+      echo "ERROR: unknown argument: $1" >&2
+      usage >&2
+      exit 2
+      ;;
+  esac
+done
+
+[[ -n "$active_file" ]] || { echo "ERROR: --active-file is required" >&2; exit 2; }
+[[ -n "$request_file" ]] || { echo "ERROR: --request-file is required" >&2; exit 2; }
+[[ -n "$prepare_command" ]] || { echo "ERROR: --prepare-command is required" >&2; exit 2; }
+[[ -n "$deploy_command" ]] || { echo "ERROR: --deploy-command is required" >&2; exit 2; }
+[[ "$active_file" != "$request_file" ]] || {
+  echo "ERROR: active/request paths must differ" >&2
+  exit 2
+}
+[[ "$(dirname "$active_file")" == "$(dirname "$request_file")" ]] || {
+  echo "ERROR: active/request paths must share one run directory" >&2
+  exit 2
+}
+[[ ! -L "$active_file" && ! -L "$request_file" ]] || {
+  echo "ERROR: sentinel paths must not be symlinks" >&2
+  exit 2
+}
+[[ -s "$active_file" ]] || {
+  echo "ERROR: active sentinel is missing or empty: $active_file" >&2
+  exit 2
+}
+[[ "$restart_delay" =~ ^[0-9]+([.][0-9]+)?$ ]] || {
+  echo "ERROR: --restart-delay must be non-negative" >&2
+  exit 2
+}
+
+inflight_file="${request_file}.inflight"
+run_dir="$(dirname "$active_file")"
+
+cleanup() {
+  rm -f "$active_file" "$request_file" "$inflight_file"
+  rmdir "$run_dir" 2>/dev/null || true
+}
+trap cleanup EXIT HUP INT TERM
+
+while [[ -f "$active_file" ]]; do
+  while [[ -f "$active_file" && ! -f "$request_file" ]]; do
+    sleep 0.1
+  done
+  [[ -f "$active_file" ]] || break
+  if ! mv "$request_file" "$inflight_file" 2>/dev/null; then
+    continue
+  fi
+
+  echo "[DeploySupervisor] attempt request received; preparing MuJoCo"
+  if ! bash -lc "$prepare_command"; then
+    echo \
+      "[DeploySupervisor] ERROR: deterministic sim prepare failed; refusing to start deploy" \
+      >&2
+    exit 1
+  fi
+  if [[ ! -f "$active_file" ]]; then
+    rm -f "$inflight_file"
+    break
+  fi
+
+  echo "[DeploySupervisor] sim reset ACK received; starting one fresh SONIC deploy"
+  set +e
+  bash -lc "$deploy_command"
+  deploy_rc=$?
+  set -e
+  rm -f "$inflight_file"
+
+  if [[ -f "$active_file" ]]; then
+    echo \
+      "[DeploySupervisor] SONIC deploy exited rc=$deploy_rc; " \
+      "waiting ${restart_delay}s for next explicit request"
+    sleep "$restart_delay"
+  else
+    echo "[DeploySupervisor] SONIC deploy exited rc=$deploy_rc; batch inactive"
+  fi
+done
+
+echo "[DeploySupervisor] stopped"

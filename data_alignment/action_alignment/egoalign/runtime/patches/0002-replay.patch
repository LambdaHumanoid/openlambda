+        """Return the next queued state instead of sampling only the latest."""
+
+        if self._msg is not None:
+            msg = self._msg
+            self._msg = None
+            return msg
+        timeout_ms = max(0, int(round(float(timeout_sec) * 1000.0)))
+        if not self._socket.poll(timeout_ms, zmq.POLLIN):
+            return None
+        return self._decode(self._socket.recv())
 
     def close(self):
         self._socket.close()

+def _load_capture_joint_series(capture_path: Path, *, key: str = "body_q") -> np.ndarray:
+    data = np.load(capture_path, allow_pickle=False)
+    candidate_keys = [key, "body_q", "body_q_measured", "last_action"]
+    seen: set[str] = set()
+    q = None
+    selected_key = ""
+    for candidate_key in candidate_keys:
+        if candidate_key in seen:
+            continue
+        seen.add(candidate_key)
+        if candidate_key not in data:
+            continue
+        arr = np.asarray(data[candidate_key], dtype=np.float64)
+        if arr.ndim == 1 and arr.size == len(SONIC_DEFAULT_ANGLES):
+            arr = arr.reshape(1, -1)
+        if arr.ndim == 2 and arr.shape[1] == len(SONIC_DEFAULT_ANGLES) and arr.size:
+            q = arr
+            selected_key = candidate_key
+            break
+    if q is None:
+        raise ValueError(f"capture npz missing [N, {len(SONIC_DEFAULT_ANGLES)}] body_q-like array: {capture_path}")
+
+    replay_index = np.asarray(data.get("replay_frame_index", np.arange(len(q))), dtype=np.int64).reshape(-1)
+    if replay_index.shape[0] == q.shape[0] and replay_index.size:
+        valid = np.isfinite(q).all(axis=1) & (replay_index >= 0)
+        if np.any(valid):
+            replay_index = replay_index[valid]
+            q_valid = q[valid]
+            frame_count = int(np.max(replay_index)) + 1
+            expanded = np.full((frame_count, q.shape[1]), np.nan, dtype=np.float64)
+            expanded[replay_index] = q_valid
+
+            valid_rows = np.isfinite(expanded).all(axis=1)
+            if np.any(valid_rows):
+                first_valid = int(np.argmax(valid_rows))
+                expanded[:first_valid] = expanded[first_valid]
+                last = expanded[first_valid].copy()
+                for row_idx in range(first_valid, frame_count):
+                    if valid_rows[row_idx]:
+                        last = expanded[row_idx].copy()
+                    else:
+                        expanded[row_idx] = last
+                q = expanded
+
+    print(f"[ReplayCompare] loaded baseline capture {capture_path} key={selected_key} frames={len(q)}", flush=True)
+    return q.astype(np.float64)
+
+
+def _load_capture_root_qpos_series(capture_path: Path) -> np.ndarray:
+    data = np.load(capture_path, allow_pickle=False)
+    pos_key = next((key for key in ("base_trans_measured", "base_trans", "base_trans_target") if key in data), "")
+    quat_key = next((key for key in ("base_quat_measured", "base_quat", "base_quat_target") if key in data), "")
+    if not pos_key or not quat_key:
+        raise ValueError(f"capture npz missing base_trans/base_quat root pose arrays: {capture_path}")
+
+    pos = np.asarray(data[pos_key], dtype=np.float64)
+    quat = np.asarray(data[quat_key], dtype=np.float64)
+    if pos.ndim == 1 and pos.size == 3:
+        pos = pos.reshape(1, 3)
+    if quat.ndim == 1 and quat.size == 4:
+        quat = quat.reshape(1, 4)
+    if pos.ndim != 2 or pos.shape[1] != 3 or quat.ndim != 2 or quat.shape[1] != 4:
+        raise ValueError(
+            f"capture root pose shape should be pos[N,3], quat[N,4], got {pos.shape}, {quat.shape}"
+        )
+
+    rows = min(pos.shape[0], quat.shape[0])
+    root_qpos = np.tile(_ROOT_QPOS, (rows, 1)).astype(np.float64)
+    pos = pos[:rows]
+    quat = quat[:rows]
+
+    finite_z = np.isfinite(pos[:, 2])
+    root_qpos[finite_z, 2] = pos[finite_z, 2]
+    if _env_flag("SONIC_REPLAY_COMPARE_USE_CAPTURE_ROOT_XY"):
+        finite_xy = np.isfinite(pos[:, :2]).all(axis=1)
+        root_qpos[finite_xy, :2] = pos[finite_xy, :2]
+
+    quat_norm = np.linalg.norm(quat, axis=1)
+    valid_quat = np.isfinite(quat).all(axis=1) & (quat_norm > 1e-6)
+    root_qpos[valid_quat, 3:7] = quat[valid_quat] / quat_norm[valid_quat, None]
+
+    replay_index = np.asarray(data.get("replay_frame_index", np.arange(rows)), dtype=np.int64).reshape(-1)
+    if replay_index.shape[0] == root_qpos.shape[0] and replay_index.size:
+        valid = np.isfinite(root_qpos).all(axis=1) & (replay_index >= 0)
+        if np.any(valid):
+            replay_index = replay_index[valid]
+            q_valid = root_qpos[valid]
+            frame_count = int(np.max(replay_index)) + 1
+            expanded = np.full((frame_count, root_qpos.shape[1]), np.nan, dtype=np.float64)
+            expanded[replay_index] = q_valid
+
+            valid_rows = np.isfinite(expanded).all(axis=1)
+            if np.any(valid_rows):
+                first_valid = int(np.argmax(valid_rows))
+                expanded[:first_valid] = expanded[first_valid]
+                last = expanded[first_valid].copy()
+                for row_idx in range(first_valid, frame_count):
+                    if valid_rows[row_idx]:
+                        last = expanded[row_idx].copy()
+                    else:
+                        expanded[row_idx] = last
+                root_qpos = expanded
+
+    print(
+        f"[ReplayCompare] loaded baseline capture root {capture_path} "
+        f"pos={pos_key} quat={quat_key} frames={len(root_qpos)}",
+        flush=True,
+    )
+    return root_qpos.astype(np.float64)
+
+
+def _load_timestamps(parquet_path: Path, column: str, enabled: bool) -> np.ndarray:
+    if not enabled:
+        return np.array([], dtype=np.float64)
+    try:
+        df = _read_parquet_table(parquet_path)
+        if column not in _read_parquet_columns(df):
+            return np.array([], dtype=np.float64)
+        ts_raw = _stack_column(df, column)
+    except ModuleNotFoundError:
+        try:
+            ts_raw = _load_parquet_column_sidecar(parquet_path, column)
+        except KeyError:
+            return np.array([], dtype=np.float64)
+    ts = _to_timestamp_seconds(np.asarray(ts_raw).reshape(-1, 1)[:, 0])
+    if ts.size == 0:
+        return ts
+    return ts - ts[0]

+def _select_replay_timing_dataframe(
+    df: pd.DataFrame,
+    *,
+    upper_body_df: pd.DataFrame | None,
+    use_upper_body_override: bool,
+    respect_timestamps: bool,
+    timestamp_column: str,
+) -> tuple[pd.DataFrame, str]:
+    if (
+        use_upper_body_override
+        and respect_timestamps
+        and upper_body_df is not None
+        and len(upper_body_df) == len(df)
+        and timestamp_column in upper_body_df.columns
+    ):
+        return upper_body_df, "upper-body"
+    return df, "episode"

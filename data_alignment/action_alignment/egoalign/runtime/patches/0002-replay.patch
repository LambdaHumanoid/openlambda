+++ b/gear_sonic/scripts/replay_timing.py
@@ -0,0 +1,50 @@
+"""Timing helpers shared by replay entrypoints."""
+
+from __future__ import annotations
+
+import numpy as np
+import pandas as pd
+
+
+def replay_sleep_schedule(
+    df: pd.DataFrame,
+    *,
+    rate: float,
+    respect_timestamps: bool = False,
+    timestamp_column: str = "timestamp",
+) -> tuple[np.ndarray, np.ndarray]:
+    """Return per-frame sleep periods and cumulative replay targets.
+
+    The replay loops send row ``i`` immediately, then sleep until cumulative
+    target ``i``. For timestamped replay, the sleep after row ``i`` is the
+    timestamp gap to row ``i + 1``; the final sleep repeats the last valid gap.
+    """
+    n = len(df)
+    if rate <= 0.0:
+        raise ValueError("rate must be positive")
+    if n <= 0:
+        return np.zeros((0,), dtype=np.float64), np.zeros((0,), dtype=np.float64)
+
+    if not respect_timestamps:
+        periods = np.full((n,), 1.0 / float(rate), dtype=np.float64)
+        return periods, np.cumsum(periods)
+
+    if timestamp_column not in df.columns:
+        raise ValueError(f"respect_timestamps requires parquet column: {timestamp_column}")
+    timestamps = np.asarray(df[timestamp_column].to_numpy(), dtype=np.float64).reshape(-1)
+    if len(timestamps) != n:
+        raise ValueError("timestamp column length does not match dataframe length")
+    if n == 1:
+        periods = np.array([1.0 / float(rate)], dtype=np.float64)
+        return periods, periods.copy()
+
+    deltas = np.diff(timestamps)
+    if not np.all(np.isfinite(timestamps)):
+        raise ValueError(f"{timestamp_column} must contain finite values")
+    if np.any(deltas <= 0.0):
+        raise ValueError(f"{timestamp_column} must be strictly increasing")
+
+    periods = np.empty((n,), dtype=np.float64)
+    periods[:-1] = deltas
+    periods[-1] = deltas[-1]
+    return periods, np.cumsum(periods)

+def _sim_video_control(
+    config: ReplayerConfig,
+    command: str,
+    *,
+    send_command=_send_sim_control_command,
+) -> dict[str, object]:
+    reply = send_command(
+        config.sim_control_host,
+        config.sim_control_port,
+        command,
+        config.sim_control_timeout,
+    )
+    try:
+        payload = json.loads(reply)
+    except json.JSONDecodeError as exc:
+        raise RuntimeError(f"invalid replay-video control reply: {reply!r}") from exc
+    if not isinstance(payload, dict):
+        raise RuntimeError(f"invalid replay-video control payload: {payload!r}")
+    if payload.get("status") == "error":
+        raise RuntimeError(str(payload.get("error", "unknown replay-video error")))
+    return payload

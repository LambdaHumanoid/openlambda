+    def drain(self):
+        """Discard queued states and return the newest one seen.
+
+        This is mainly used by deterministic replay capture.  Its subscriber
+        disables CONFLATE so every C++ control tick remains available, then
+        drains pre-replay PLANNER/ramp states immediately before formal replay.

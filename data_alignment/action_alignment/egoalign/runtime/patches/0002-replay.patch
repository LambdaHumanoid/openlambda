+def _row_vector(row, key: str, expected_size: int) -> np.ndarray | None:
+    if key not in row:
+        return None
+    try:
+        arr = np.asarray(row[key], dtype=np.float32).reshape(-1)
+    except Exception:
+        return None
+    if arr.size != expected_size or not np.isfinite(arr).all():
+        return None
+    return arr

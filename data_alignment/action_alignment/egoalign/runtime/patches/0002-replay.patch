+
+    legacy_pose_wire: bool = False
+    """Use the old flat SMPL POSE wire shape for baseline replay compatibility."""
+
+    baseline_ramp_parquet: str = ""
+    """Optional baseline PICO/SMPL parquet used for strict first-frame pre-alignment."""
+
+    initial_body_q_reference_path: str = ""
+    """Optional strict-A/B baseline measured 29D first-frame reference (.npz)."""

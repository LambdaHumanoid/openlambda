+        STRICT_AB_INITIAL_BODY_Q_MAX_ERROR_DEG
+    )
+    """Maximum per-joint wrapped error allowed at the formal replay gate."""
+
+    initial_body_q_rms_error_rad: float = math.radians(
+        STRICT_AB_INITIAL_BODY_Q_RMS_ERROR_DEG
+    )
+    """Maximum 29D wrapped RMS error allowed at the formal replay gate."""
+
+    upper_body_joint_parquet: str = ""
+    """Optional G1 joint parquet whose 17 upper-body joints override POSE replay."""
+
+    joint_pos_is_offset: bool = True
+    """Treat teleop.g1_joint_pos as SONIC/IsaacLab default-relative offsets."""
+
+    upper_body_blend_seconds: float = 1.0
+    """Seconds to blend upper-body override from an initial anchor toward episode overlay."""
+
+    upper_body_settle_seconds: float = 2.0
+    """Seconds to keep sending the first upper-body overlay before the Enter prompt."""
+
+    upper_body_interpolation_factor: int = 1
+    """Upper-body override samples per replay frame; 1 disables runtime interpolation."""
+
+    respect_timestamps: bool = False
+    """Use parquet timestamp gaps for playback timing instead of fixed --rate."""
+
+    timestamp_column: str = "timestamp"
+    """Timestamp column used when --respect-timestamps is enabled."""
+
+    ramp_state_dump_path: str = ""
+    """Optional .npz path to save g1_debug state after the first-frame ramp."""
+
+    ramp_state_dump_samples: int = 20
+    """Number of state messages to sample after ramp before writing the dump."""
+
+    exit_after_ramp_state_dump: bool = False
+    """Exit after writing --ramp-state-dump-path."""
+
+    release_elastic_band_before_replay: bool = False
+    """Release MuJoCo support before first-frame ramp and guard against hidden reset."""
+
+    reset_sim_before_replay: bool = False
+    """Ask the MuJoCo sim loop to reset before starting the C++ control loop."""
+
+    start_replay_compare: bool = False
+    """Synchronize MuJoCo replay-compare overlay with actual replay playback."""
+
+    sim_control_host: str = "localhost"
+    """MuJoCo sim control host used by --release-elastic-band-before-replay."""
+
+    sim_control_port: int = 5562
+    """MuJoCo sim control REP port used by --release-elastic-band-before-replay."""
+
+    sim_control_timeout: float = 2.0
+    """Seconds to wait for the MuJoCo sim control reply."""
+
+    sim_control_settle_seconds: float = 1.0
+    """Minimum consecutive stable seconds required after releasing the elastic band."""
+
+    sim_stability_timeout: float = 15.0
+    """Max seconds to wait for MuJoCo to become physically stationary at each pre-align stage."""
+
+    sim_stability_poll_hz: float = 10.0
+    """MuJoCo state polling rate used by the physical-stability gate."""
+
+    sim_stability_hold_seconds: float = 0.5
+    """Consecutive simulated seconds below all motion thresholds required for stability."""
+
+    sim_max_root_linear_speed: float = 0.10
+    """Maximum root linear speed in m/s accepted as physically stable."""
+
+    sim_max_root_angular_speed: float = 0.35
+    """Maximum root angular speed in rad/s accepted as physically stable."""
+
+    sim_max_body_joint_speed: float = 1.0
+    """Maximum absolute body-joint speed in rad/s accepted as physically stable."""
+
+    state_capture_path: str = ""
+    """Optional .npz path to save g1_debug samples collected during replay."""
+
+    state_capture_every: int = 1
+    """Capture one g1_debug sample every N replay frames when --state-capture-path is set."""
+
+    sim_video_name: str = ""
+    """Safe MP4 filename recorded by the MuJoCo sim during the formal replay rows only."""

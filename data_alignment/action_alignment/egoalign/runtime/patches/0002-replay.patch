--- /dev/null
+++ b/gear_sonic/postprocessing/velocity_quality/telemetry.py
@@ -0,0 +1,415 @@
+"""Capture and load replay telemetry aligned to source and video frames.
+
+This module intentionally depends only on NumPy and the standard library so it
+can be imported by both the light-weight MuJoCo venv and the data venv.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import os
+from pathlib import Path
+import time
+from typing import Iterable, Mapping
+
+import numpy as np
+
+from .schema import SMPL_JOINT_NAMES, TELEMETRY_FORMAT_VERSION
+
+
+def _video_stem(video_name: str | Path) -> str:
+    return Path(video_name).stem
+
+
+def sim_telemetry_path(output_dir: str | Path, video_name: str | Path) -> Path:
+    return Path(output_dir) / "telemetry" / f"{_video_stem(video_name)}.sim.npz"
+
+
+def reference_telemetry_path(output_dir: str | Path, video_name: str | Path) -> Path:
+    return Path(output_dir) / "telemetry" / f"{_video_stem(video_name)}.reference.npz"
+
+
+def _atomic_savez(path: Path, **arrays: np.ndarray) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
+    try:
+        with temporary.open("wb") as file:
+            np.savez_compressed(file, **arrays)
+        os.replace(temporary, path)
+    finally:
+        try:
+            temporary.unlink()
+        except FileNotFoundError:
+            pass
+
+
+def _string_array(values: Iterable[str]) -> np.ndarray:
+    return np.asarray(tuple(values), dtype=np.str_)
+
+
+def _vector(
+    sample: Mapping[str, object],
+    name: str,
+    length: int,
+) -> np.ndarray:
+    value = np.asarray(sample[name], dtype=np.float64).reshape(-1)
+    if value.shape != (length,):
+        raise ValueError(f"telemetry {name} shape {value.shape} != ({length},)")
+    if not np.all(np.isfinite(value)):
+        raise ValueError(f"telemetry {name} contains non-finite values")
+    return value.copy()
+
+
+class SimTelemetryBuffer:
+    """In-memory, episode-scoped telemetry writer for rendered video frames."""
+
+    def __init__(
+        self,
+        path: str | Path,
+        *,
+        video_name: str,
+        fps: float,
+        joint_names: Iterable[str],
+    ) -> None:
+        self.path = Path(path)
+        self.video_name = str(video_name)
+        self.fps = float(fps)
+        self.joint_names = tuple(str(name) for name in joint_names)
+        if self.fps <= 0:
+            raise ValueError("telemetry fps must be positive")
+        if not self.joint_names:
+            raise ValueError("sim telemetry requires named body joints")
+        self._rows: dict[str, list[object]] = {
+            "video_frame_index": [],
+            "monotonic_ns": [],
+            "sim_time_s": [],
+            "root_position": [],
+            "root_quaternion_wxyz": [],
+            "root_linear_velocity": [],
+            "root_angular_velocity": [],
+            "body_joint_position": [],
+            "body_joint_velocity": [],
+        }
+
+    @property
+    def sample_count(self) -> int:
+        return len(self._rows["video_frame_index"])
+
+    def add(self, sample: Mapping[str, object]) -> None:
+        joint_count = len(self.joint_names)
+        self._rows["video_frame_index"].append(self.sample_count)
+        self._rows["monotonic_ns"].append(
+            int(sample.get("monotonic_ns", time.monotonic_ns()))
+        )
+        self._rows["sim_time_s"].append(float(sample["sim_time_s"]))
+        self._rows["root_position"].append(_vector(sample, "root_position", 3))
+        self._rows["root_quaternion_wxyz"].append(
+            _vector(sample, "root_quaternion_wxyz", 4)
+        )
+        self._rows["root_linear_velocity"].append(
+            _vector(sample, "root_linear_velocity", 3)
+        )
+        self._rows["root_angular_velocity"].append(
+            _vector(sample, "root_angular_velocity", 3)
+        )
+        self._rows["body_joint_position"].append(
+            _vector(sample, "body_joint_position", joint_count)
+        )
+        self._rows["body_joint_velocity"].append(
+            _vector(sample, "body_joint_velocity", joint_count)
+        )
+
+    def save(self) -> Path:
+        count = self.sample_count
+        joint_count = len(self.joint_names)
+
+        def matrix(name: str, width: int) -> np.ndarray:
+            if count == 0:
+                return np.empty((0, width), dtype=np.float64)
+            return np.stack(self._rows[name], axis=0).astype(np.float64, copy=False)
+
+        _atomic_savez(
+            self.path,
+            format_version=np.asarray(TELEMETRY_FORMAT_VERSION, dtype=np.int32),
+            video_name=np.asarray(self.video_name, dtype=np.str_),
+            fps=np.asarray(self.fps, dtype=np.float64),
+            joint_names=_string_array(self.joint_names),
+            video_frame_index=np.asarray(
+                self._rows["video_frame_index"], dtype=np.int32
+            ),
+            monotonic_ns=np.asarray(self._rows["monotonic_ns"], dtype=np.int64),
+            sim_time_s=np.asarray(self._rows["sim_time_s"], dtype=np.float64),
+            root_position=matrix("root_position", 3),
+            root_quaternion_wxyz=matrix("root_quaternion_wxyz", 4),
+            root_linear_velocity=matrix("root_linear_velocity", 3),
+            root_angular_velocity=matrix("root_angular_velocity", 3),
+            body_joint_position=matrix("body_joint_position", joint_count),
+            body_joint_velocity=matrix("body_joint_velocity", joint_count),
+        )
+        return self.path
+
+    def cancel(self) -> None:
+        try:
+            self.path.unlink()
+        except FileNotFoundError:
+            pass
+
+
+class ReferenceTelemetryBuffer:
+    """Formal replay source rows with their actual monotonic send timestamps."""
+
+    def __init__(
+        self,
+        path: str | Path,
+        *,
+        joint_names: Iterable[str],
+        replay_rate: float,
+    ) -> None:
+        self.path = Path(path)
+        self.joint_names = tuple(str(name) for name in joint_names)
+        self.replay_rate = float(replay_rate)
+        if self.replay_rate <= 0:
+            raise ValueError("reference replay rate must be positive")
+        if not self.joint_names:
+            raise ValueError("reference telemetry requires named joints")
+        self._rows: dict[str, list[object]] = {
+            "replay_frame_index": [],
+            "source_row_index": [],
+            "source_frame_index": [],
+            "source_timestamp_s": [],
+            "send_monotonic_ns": [],
+            "reference_joint_position": [],
+            "reference_joint_velocity": [],
+            "reference_smpl_joints": [],
+        }
+
+    @property
+    def sample_count(self) -> int:
+        return len(self._rows["replay_frame_index"])
+
+    def add(
+        self,
+        *,
+        replay_frame_index: int,
+        source_row_index: int,
+        source_frame_index: int,
+        source_timestamp_s: float,
+        send_monotonic_ns: int,
+        reference_joint_position: np.ndarray,
+        reference_joint_velocity: np.ndarray,
+        reference_smpl_joints: np.ndarray,
+    ) -> None:
+        joint_count = len(self.joint_names)
+        position = np.asarray(reference_joint_position, dtype=np.float64).reshape(-1)
+        velocity = np.asarray(reference_joint_velocity, dtype=np.float64).reshape(-1)
+        if position.shape != (joint_count,) or velocity.shape != (joint_count,):
+            raise ValueError(
+                "reference telemetry joint shape mismatch: "
+                f"position={position.shape}, velocity={velocity.shape}, "
+                f"expected=({joint_count},)"
+            )
+        smpl_joints = np.asarray(reference_smpl_joints, dtype=np.float64).reshape(-1)
+        expected_smpl_size = len(SMPL_JOINT_NAMES) * 3
+        if smpl_joints.shape != (expected_smpl_size,):
+            raise ValueError(
+                "reference telemetry SMPL shape mismatch: "
+                f"{smpl_joints.shape} != ({expected_smpl_size},)"
+            )
+        self._rows["replay_frame_index"].append(int(replay_frame_index))
+        self._rows["source_row_index"].append(int(source_row_index))
+        self._rows["source_frame_index"].append(int(source_frame_index))
+        self._rows["source_timestamp_s"].append(float(source_timestamp_s))
+        self._rows["send_monotonic_ns"].append(int(send_monotonic_ns))
+        self._rows["reference_joint_position"].append(position.copy())
+        self._rows["reference_joint_velocity"].append(velocity.copy())
+        self._rows["reference_smpl_joints"].append(smpl_joints.copy())
+
+    def save(self) -> Path:
+        count = self.sample_count
+        joint_count = len(self.joint_names)
+
+        def matrix(name: str) -> np.ndarray:
+            if count == 0:
+                return np.empty((0, joint_count), dtype=np.float64)
+            return np.stack(self._rows[name], axis=0).astype(np.float64, copy=False)
+
+        def smpl_matrix() -> np.ndarray:
+            width = len(SMPL_JOINT_NAMES) * 3
+            if count == 0:
+                return np.empty((0, width), dtype=np.float64)
+            return np.stack(self._rows["reference_smpl_joints"], axis=0).astype(
+                np.float64, copy=False
+            )
+
+        _atomic_savez(
+            self.path,
+            format_version=np.asarray(TELEMETRY_FORMAT_VERSION, dtype=np.int32),
+            replay_rate=np.asarray(self.replay_rate, dtype=np.float64),
+            joint_names=_string_array(self.joint_names),
+            replay_frame_index=np.asarray(
+                self._rows["replay_frame_index"], dtype=np.int32
+            ),
+            source_row_index=np.asarray(self._rows["source_row_index"], dtype=np.int32),
+            source_frame_index=np.asarray(
+                self._rows["source_frame_index"], dtype=np.int64
+            ),
+            source_timestamp_s=np.asarray(
+                self._rows["source_timestamp_s"], dtype=np.float64
+            ),
+            send_monotonic_ns=np.asarray(
+                self._rows["send_monotonic_ns"], dtype=np.int64
+            ),
+            reference_joint_position=matrix("reference_joint_position"),
+            reference_joint_velocity=matrix("reference_joint_velocity"),
+            smpl_joint_names=_string_array(SMPL_JOINT_NAMES),
+            reference_smpl_joints=smpl_matrix(),
+        )
+        return self.path
+
+    def cancel(self) -> None:
+        try:
+            self.path.unlink()
+        except FileNotFoundError:
+            pass
+
+
+@dataclass(frozen=True)
+class SimTelemetry:
+    path: Path
+    video_name: str
+    fps: float
+    joint_names: tuple[str, ...]
+    video_frame_index: np.ndarray
+    monotonic_ns: np.ndarray
+    sim_time_s: np.ndarray
+    root_position: np.ndarray
+    root_quaternion_wxyz: np.ndarray
+    root_linear_velocity: np.ndarray
+    root_angular_velocity: np.ndarray
+    body_joint_position: np.ndarray
+    body_joint_velocity: np.ndarray
+
+
+@dataclass(frozen=True)
+class ReferenceTelemetry:
+    path: Path
+    replay_rate: float
+    joint_names: tuple[str, ...]
+    replay_frame_index: np.ndarray
+    source_row_index: np.ndarray
+    source_frame_index: np.ndarray
+    source_timestamp_s: np.ndarray
+    send_monotonic_ns: np.ndarray
+    reference_joint_position: np.ndarray
+    reference_joint_velocity: np.ndarray
+    smpl_joint_names: tuple[str, ...]
+    reference_smpl_joints: np.ndarray
+
+
+def _load_version(data: np.lib.npyio.NpzFile, path: Path) -> None:
+    version = int(np.asarray(data["format_version"]).item())
+    if version != TELEMETRY_FORMAT_VERSION:
+        raise ValueError(
+            f"unsupported telemetry format {version} in {path}; "
+            f"expected {TELEMETRY_FORMAT_VERSION}"
+        )
+
+
+def load_sim_telemetry(path: str | Path) -> SimTelemetry:
+    resolved = Path(path).expanduser().resolve()
+    with np.load(resolved, allow_pickle=False) as data:
+        _load_version(data, resolved)
+        result = SimTelemetry(
+            path=resolved,
+            video_name=str(np.asarray(data["video_name"]).item()),
+            fps=float(np.asarray(data["fps"]).item()),
+            joint_names=tuple(str(value) for value in data["joint_names"].tolist()),
+            video_frame_index=data["video_frame_index"].astype(np.int32),
+            monotonic_ns=data["monotonic_ns"].astype(np.int64),
+            sim_time_s=data["sim_time_s"].astype(np.float64),
+            root_position=data["root_position"].astype(np.float64),
+            root_quaternion_wxyz=data["root_quaternion_wxyz"].astype(np.float64),
+            root_linear_velocity=data["root_linear_velocity"].astype(np.float64),
+            root_angular_velocity=data["root_angular_velocity"].astype(np.float64),
+            body_joint_position=data["body_joint_position"].astype(np.float64),
+            body_joint_velocity=data["body_joint_velocity"].astype(np.float64),
+        )
+    count = len(result.video_frame_index)
+    if result.fps <= 0:
+        raise ValueError(f"invalid sim telemetry fps in {resolved}: {result.fps}")
+    if not np.array_equal(result.video_frame_index, np.arange(count, dtype=np.int32)):
+        raise ValueError(f"non-contiguous video frame indices in {resolved}")
+    for name in (
+        "monotonic_ns",
+        "sim_time_s",
+        "root_position",
+        "root_quaternion_wxyz",
+        "root_linear_velocity",
+        "root_angular_velocity",
+        "body_joint_position",
+        "body_joint_velocity",
+    ):
+        if len(getattr(result, name)) != count:
+            raise ValueError(f"sim telemetry length mismatch for {name} in {resolved}")
+    expected_joint_shape = (count, len(result.joint_names))
+    for name in ("body_joint_position", "body_joint_velocity"):
+        if getattr(result, name).shape != expected_joint_shape:
+            raise ValueError(
+                f"sim telemetry shape mismatch for {name} in {resolved}: "
+                f"{getattr(result, name).shape} != {expected_joint_shape}"
+            )
+    return result
+
+
+def load_reference_telemetry(path: str | Path) -> ReferenceTelemetry:
+    resolved = Path(path).expanduser().resolve()
+    with np.load(resolved, allow_pickle=False) as data:
+        _load_version(data, resolved)
+        result = ReferenceTelemetry(
+            path=resolved,
+            replay_rate=float(np.asarray(data["replay_rate"]).item()),
+            joint_names=tuple(str(value) for value in data["joint_names"].tolist()),
+            replay_frame_index=data["replay_frame_index"].astype(np.int32),
+            source_row_index=data["source_row_index"].astype(np.int32),
+            source_frame_index=data["source_frame_index"].astype(np.int64),
+            source_timestamp_s=data["source_timestamp_s"].astype(np.float64),
+            send_monotonic_ns=data["send_monotonic_ns"].astype(np.int64),
+            reference_joint_position=data["reference_joint_position"].astype(np.float64),
+            reference_joint_velocity=data["reference_joint_velocity"].astype(np.float64),
+            smpl_joint_names=tuple(
+                str(value) for value in data["smpl_joint_names"].tolist()
+            ),
+            reference_smpl_joints=data["reference_smpl_joints"].astype(np.float64),
+        )
+    count = len(result.replay_frame_index)
+    if result.replay_rate <= 0:
+        raise ValueError(
+            f"invalid reference replay rate in {resolved}: {result.replay_rate}"
+        )
+    if not np.array_equal(result.replay_frame_index, np.arange(count, dtype=np.int32)):
+        raise ValueError(f"non-contiguous replay frame indices in {resolved}")
+    for name in (
+        "source_row_index",
+        "source_frame_index",
+        "source_timestamp_s",
+        "send_monotonic_ns",
+        "reference_joint_position",

+def _shift_root_position(node: ET.Element, *, x_offset: float, y_offset: float, z_offset: float) -> None:
+    old_pos = node.get("pos", "0 0 0")
+    try:
+        x, y, z = [float(v) for v in old_pos.split()]
+    except Exception:
+        x, y, z = (0.0, 0.0, 0.0)
+    node.set("pos", f"{x + x_offset} {y + y_offset} {z + z_offset}")
+
+
+def _prefix_names(node: ET.Element, prefix: str) -> None:
+    if "name" in node.attrib:
+        node.set("name", f"{prefix}{node.attrib['name']}")
+    for child in node:
+        _prefix_names(child, prefix)
+
+
+def _make_replay_overlay_visual_only(node: ET.Element) -> None:
+    for geom in node.iter("geom"):
+        geom.set("contype", "0")
+        geom.set("conaffinity", "0")
+

--- /dev/null
+++ b/scripts/runtime_config.py
@@ -0,0 +1,72 @@
+"""Read the shared SONIC replay runtime environment defaults.
+
+The canonical values live in ``config/robot.env`` so Bash entrypoints can
+source them directly.  Python utilities use this small reader rather than
+duplicating robot addresses.  Environment variables always take precedence,
+including when a caller selects a different config with
+``G1_WBC_RUNTIME_CONFIG``.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+from pathlib import Path
+
+
+_DEFAULT_EXPR = re.compile(r'^\$\{([A-Za-z_][A-Za-z0-9_]*):-([^}]*)\}$')
+
+
+def _config_path() -> Path:
+    configured = os.environ.get("G1_WBC_RUNTIME_CONFIG")
+    if configured:
+        return Path(configured).expanduser()
+    return Path(__file__).resolve().parent.parent / "config" / "robot.env"
+
+
+def load_runtime_config() -> None:
+    """Load unset variables from the shared shell config without overriding env."""
+    path = _config_path()
+    if not path.is_file():
+        return
+
+    for raw_line in path.read_text(encoding="utf-8").splitlines():
+        line = raw_line.strip()
+        if not line or line.startswith("#"):
+            continue
+        if line.startswith("export "):
+            line = line[len("export ") :].strip()
+        if "=" not in line:
+            continue
+
+        key, raw_value = (part.strip() for part in line.split("=", 1))
+        if not key or key in os.environ:
+            continue
+        if len(raw_value) >= 2 and raw_value[0] == raw_value[-1] and raw_value[0] in "\"'":
+            raw_value = raw_value[1:-1]
+        match = _DEFAULT_EXPR.fullmatch(raw_value)
+        if match:
+            referenced_key, default = match.groups()
+            os.environ[key] = os.environ.get(referenced_key, default)
+        else:
+            os.environ[key] = raw_value
+
+
+def _required(name: str) -> str:
+    load_runtime_config()
+    value = os.environ.get(name, "").strip()
+    if not value:
+        raise RuntimeError(
+            f"{name} is not configured; set it or update {_config_path()}"
+        )
+    return value
+
+
+def default_wireless_robot_ip() -> str:
+    """Return the configured default target for wireless robot workflows."""
+    return _required("G1_WBC_DEFAULT_WIRELESS_ROBOT_IP")
+
+
+def default_wired_robot_ip() -> str:
+    """Return the configured default target for wired robot workflows."""
+    return _required("G1_WBC_DEFAULT_WIRED_ROBOT_IP")

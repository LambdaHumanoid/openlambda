+def _build_dual_robot_model(
+    robot_xml: Path,
+    *,
+    overlay_prefix: str = "overlay_",
+    overlay_offset_x: float = 1.05,
+    overlay_offset_y: float = 0.0,
+    overlay_offset_z: float = 0.0,
+) -> Path:
+    tree = ET.parse(robot_xml)
+    root = tree.getroot()
+    if root.tag != "mujoco":
+        raise ValueError("robot xml root node should be <mujoco>")
+
+    compiler = root.find("compiler")
+    if compiler is not None:
+        meshdir = compiler.get("meshdir", "meshes")
+        compiler.set("meshdir", str((robot_xml.parent / meshdir).resolve()))
+
+    worldbody = root.find("worldbody")
+    if worldbody is None:
+        raise ValueError("robot xml missing <worldbody>")
+
+    robot_bodies = [copy.deepcopy(node) for node in worldbody if node.tag == "body"]
+    if not robot_bodies:
+        return robot_xml
+
+    for node in robot_bodies:
+        _prefix_names(node, overlay_prefix)
+        _make_replay_overlay_visual_only(node)
+        _shift_root_position(
+            node,
+            x_offset=overlay_offset_x,
+            y_offset=overlay_offset_y,
+            z_offset=overlay_offset_z,
+        )
+        worldbody.append(node)
+
+    tmp = tempfile.NamedTemporaryFile(delete=False, suffix=".xml", prefix="replay_dual_", dir=str(robot_xml.parent))
+    tmp_path = Path(tmp.name)
+    tmp.close()
+    ET.ElementTree(root).write(tmp_path, encoding="utf-8")
+    return tmp_path
+
+
+def _build_scene_with_robot_model(scene_xml: Path, robot_xml: Path) -> Path:
+    scene_tree = ET.parse(scene_xml)
+    scene_root = scene_tree.getroot()
+    robot_tree = ET.parse(robot_xml)
+    robot_root = robot_tree.getroot()
+
+    if scene_root.tag != "mujoco" or robot_root.tag != "mujoco":
+        raise ValueError("scene and robot xml root node should be <mujoco>")
+
+    for include in list(scene_root.findall("include")):
+        scene_root.remove(include)
+
+    robot_compiler = robot_root.find("compiler")
+    if robot_compiler is not None:
+        compiler = scene_root.find("compiler")
+        if compiler is None:
+            compiler = ET.Element("compiler")
+            scene_root.insert(0, compiler)
+        meshdir = robot_compiler.get("meshdir", "meshes")
+        compiler.set("meshdir", str((robot_xml.parent / meshdir).resolve()))
+
+    scene_asset = scene_root.find("asset")
+    robot_asset = robot_root.find("asset")
+    if robot_asset is not None:
+        if scene_asset is None:
+            scene_asset = ET.Element("asset")
+            scene_root.append(scene_asset)
+        for child in robot_asset:
+            scene_asset.append(copy.deepcopy(child))
+
+    scene_worldbody = scene_root.find("worldbody")
+    robot_worldbody = robot_root.find("worldbody")
+    if scene_worldbody is None or robot_worldbody is None:
+        raise ValueError("scene/robot xml missing <worldbody>")
+    for child in robot_worldbody:
+        scene_worldbody.append(copy.deepcopy(child))
+
+    for tag in ("default", "actuator", "sensor", "tendon", "contact", "equality"):
+        for section in robot_root.findall(tag):
+            scene_root.append(copy.deepcopy(section))
+
+    tmp = tempfile.NamedTemporaryFile(delete=False, suffix=".xml", prefix="replay_scene_", dir=str(robot_xml.parent))
+    tmp_path = Path(tmp.name)
+    tmp.close()
+    ET.ElementTree(scene_root).write(tmp_path, encoding="utf-8")
+    return tmp_path
+
